<Window
    x:Class="FluentFlyout.App.NextUpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppSurfaceBrush}"
          BorderBrush="{ThemeResource AppMutedTextBrush}"
          BorderThickness="0.5"
          CornerRadius="12"
          Padding="12,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Up Next Tag -->
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,10,0">
            <FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="{ThemeResource BrandAccentBrush}" />
            <TextBlock Text="Up Next" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppMutedTextBrush}" />
        </StackPanel>

        <!-- Artwork thumbnail -->
        <Border Grid.Column="1"
                Width="36"
                Height="36"
                CornerRadius="6"
                Background="{ThemeResource BrandAccentSecondaryBrush}"
                Margin="0,0,10,0"
                VerticalAlignment="Center">
            <Grid>
                <FontIcon x:Name="FallbackIcon" Glyph="&#xE8D6;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="ArtworkImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Title & Artist -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
            <TextBlock x:Name="TitleText" Text="Track Title" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppTextBrush}" />
            <TextBlock x:Name="ArtistText" Text="Artist Name" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppMutedTextBrush}" />
        </StackPanel>
    </Grid>
</Window>
