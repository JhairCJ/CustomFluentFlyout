<Page
    x:Class="FluentFlyout.App.Pages.AppFilteringPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FluentFlyout.App.Controls"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Spacing="16" Margin="32,28,40,40" MaxWidth="800">
            <TextBlock Text="SECURITY &amp; PRIVACY" FontSize="11" CharacterSpacing="140" Opacity="0.7" />
            <TextBlock Text="App Filtering" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Filter which media applications trigger FluentFlyout." FontSize="14" Opacity="0.75" />

            <controls:SettingsCard Title="Enable App Filtering" Description="Ignore or restrict flyouts to specific applications">
                <controls:SettingsCard.CardContent>
                    <ToggleSwitch x:Name="FilteringToggle" Toggled="SettingChanged" />
                </controls:SettingsCard.CardContent>
            </controls:SettingsCard>

            <controls:SettingsCard Title="Filtering Mode" Description="Choose between blocklist or allowlist">
                <controls:SettingsCard.CardContent>
                    <ComboBox x:Name="ModeComboBox" Width="180" SelectionChanged="ModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Blocklist" />
                        <ComboBoxItem Content="Allowlist" />
                    </ComboBox>
                </controls:SettingsCard.CardContent>
            </controls:SettingsCard>

            <controls:SettingsCard Title="Add Application" Description="Enter the exact process name or app ID (e.g. Spotify.exe)">
                <controls:SettingsCard.CardContent>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="NewAppTextBox" Width="180" PlaceholderText="app.exe" />
                        <Button Content="Add" Click="AddButton_Click" />
                    </StackPanel>
                </controls:SettingsCard.CardContent>
            </controls:SettingsCard>

            <TextBlock Text="Filtered Apps" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ListView x:Name="AppsListView" SelectionMode="None" MaxHeight="220" BorderBrush="{ThemeResource AppMutedTextBrush}" BorderThickness="0.5" CornerRadius="8">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="RemoveButton_Click">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
