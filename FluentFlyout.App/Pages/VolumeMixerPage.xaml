<Page
    x:Class="FluentFlyout.App.Pages.VolumeMixerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FluentFlyout.App.Controls"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Spacing="16" Margin="32,28,40,40" MaxWidth="800">
            <TextBlock Text="AUDIO" FontSize="11" CharacterSpacing="140" Opacity="0.7" />
            <TextBlock Text="Volume Mixer" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Configure volume control flyout and application volume mixer." FontSize="14" Opacity="0.75" />

            <controls:SettingsCard Title="Enable Volume Flyout" Description="Show flyout indicator when volume keys are pressed">
                <controls:SettingsCard.CardContent>
                    <ToggleSwitch x:Name="VolumeFlyoutToggle" Toggled="SettingChanged" />
                </controls:SettingsCard.CardContent>
            </controls:SettingsCard>

            <controls:SettingsCard Title="Enable Volume Mixer" Description="Allow expanding the flyout to control individual app volumes">
                <controls:SettingsCard.CardContent>
                    <ToggleSwitch x:Name="VolumeMixerToggle" Toggled="SettingChanged" />
                </controls:SettingsCard.CardContent>
            </controls:SettingsCard>

            <controls:SettingsCard Title="Flyout Stay Duration" Description="Time the volume flyout stays visible in milliseconds">
                <controls:SettingsCard.CardContent>
                    <Slider x:Name="DurationSlider" Width="180" Minimum="1000" Maximum="10000" StepFrequency="500" ValueChanged="SliderChanged" />
                </controls:SettingsCard.CardContent>
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
