<Page
    x:Class="FluentFlyout.App.Pages.TaskbarWidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16" Margin="32,28,40,40" MaxWidth="800">
            <TextBlock Text="TASKBAR" FontSize="11" CharacterSpacing="140" Opacity="0.7" />
            <TextBlock Text="Taskbar Widget" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="A compact media surface that lives in the taskbar, with a spinning album background."
                       FontSize="14" Opacity="0.75" TextWrapping="Wrap" />

            <ToggleSwitch x:Name="EnableToggle" Header="Enable taskbar widget" Toggled="OnChanged" />
            <ToggleSwitch x:Name="AutoHideToggle" Header="Hide when playback is paused" Toggled="OnChanged" />

            <TextBlock Text="Content" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ToggleSwitch x:Name="AlbumArtToggle" Header="Show album art" Toggled="OnChanged" />
            <ToggleSwitch x:Name="ControlsToggle" Header="Playback controls" Toggled="OnChanged" />

            <TextBlock Text="Spinning background" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ToggleSwitch x:Name="BackgroundBlurToggle" Header="Album background blur" Toggled="OnChanged" />
            <ToggleSwitch x:Name="RotateToggle" Header="Rotate background" Toggled="OnChanged" />
            <ComboBox x:Name="RotateDirectionCombo" Header="Direction" SelectionChanged="OnSelectionChanged">
                <ComboBoxItem Content="Spin down (clockwise)" />
                <ComboBoxItem Content="Spin up (counter-clockwise)" />
            </ComboBox>
            <Slider x:Name="RotateDurationSlider" Header="Rotation duration (seconds)" Minimum="5" Maximum="60" StepFrequency="1" ValueChanged="OnSliderChanged" />
            <Slider x:Name="RotateSizeSlider" Header="Disc size (%)" Minimum="100" Maximum="300" StepFrequency="5" ValueChanged="OnSliderChanged" />
            <Slider x:Name="BlurIntensitySlider" Header="Background intensity (%)" Minimum="0" Maximum="100" StepFrequency="5" ValueChanged="OnSliderChanged" />

            <TextBlock Text="Position" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ComboBox x:Name="PositionCombo" Header="Widget position" SelectionChanged="OnSelectionChanged">
                <ComboBoxItem Content="Near start" />
                <ComboBoxItem Content="Center" />
                <ComboBoxItem Content="Next to system tray" />
            </ComboBox>
        </StackPanel>
    </ScrollViewer>
</Page>
