<Window
    x:Class="FluentFlyout.App.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FluentFlyout.App.Controls"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppBackgroundBrush}" Padding="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,24">
            <Border Width="42" Height="42" CornerRadius="10" Background="{ThemeResource BrandAccentBrush}">
                <FontIcon Glyph="&#xE8D6;" FontSize="20" Foreground="#081218" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Welcome to FluentFlyout" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource AppTextBrush}" />
                <TextBlock Text="Let's configure your playback experience on Windows 11" FontSize="13" Foreground="{ThemeResource AppMutedTextBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Content Wizard -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
                <controls:SettingsCard Title="Media Flyout" Description="Show a modern, responsive flyout whenever you press media keys">
                    <controls:SettingsCard.CardContent>
                        <ToggleSwitch x:Name="MediaFlyoutToggle" IsOn="True" />
                    </controls:SettingsCard.CardContent>
                </controls:SettingsCard>

                <controls:SettingsCard Title="Taskbar Widget" Description="Embed real-time media title and controls directly in your Windows 11 taskbar">
                    <controls:SettingsCard.CardContent>
                        <ToggleSwitch x:Name="TaskbarWidgetToggle" IsOn="False" />
                    </controls:SettingsCard.CardContent>
                </controls:SettingsCard>

                <controls:SettingsCard Title="Lock Keys Flyout" Description="Display subtle pill indicators when Caps Lock, Num Lock, or Scroll Lock is pressed">
                    <controls:SettingsCard.CardContent>
                        <ToggleSwitch x:Name="LockKeysToggle" IsOn="True" />
                    </controls:SettingsCard.CardContent>
                </controls:SettingsCard>

                <controls:SettingsCard Title="Start on Boot" Description="Launch FluentFlyout quietly in the background when Windows starts">
                    <controls:SettingsCard.CardContent>
                        <ToggleSwitch x:Name="StartupToggle" IsOn="True" />
                    </controls:SettingsCard.CardContent>
                </controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Navigation -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <Button Content="Get Started" Style="{StaticResource AccentIconButtonStyle}" Width="140" Height="36" CornerRadius="8" Click="GetStarted_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
