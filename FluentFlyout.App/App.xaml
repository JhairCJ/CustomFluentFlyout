<Application
    x:Class="FluentFlyout.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F7FA" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#17202A" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#5D6875" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0C1117" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#151D27" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#F3F7FC" />
                    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#A6B1BF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="BrandAccentBrush" Color="#55D6BE" />
            <SolidColorBrush x:Key="BrandAccentSecondaryBrush" Color="#7597FF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
