<Window
    x:Class="FluentFlyout.App.VolumeMixerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootContainer"
          Background="{ThemeResource AppSurfaceBrush}"
          BorderBrush="{ThemeResource AppMutedTextBrush}"
          BorderThickness="0.5"
          CornerRadius="12"
          Padding="12,8"
          PointerEntered="RootContainer_PointerEntered"
          PointerExited="RootContainer_PointerExited">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Master Volume Row -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Mute / Speaker Icon -->
            <Button x:Name="MuteButton"
                    Style="{StaticResource IconButtonStyle}"
                    Width="30"
                    Height="30"
                    Margin="0,0,6,0"
                    Click="MuteButton_Click">
                <FontIcon x:Name="SpeakerIcon" Glyph="&#xE995;" FontSize="15" />
            </Button>

            <!-- Master Slider -->
            <Slider x:Name="MasterSlider"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="100"
                    Value="50"
                    VerticalAlignment="Center"
                    ValueChanged="MasterSlider_ValueChanged" />

            <!-- Percent Text -->
            <TextBlock x:Name="PercentText"
                       Grid.Column="2"
                       Text="50%"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Width="34"
                       TextAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="6,0,6,0" />

            <!-- Expand button -->
            <Button x:Name="ExpandButton"
                    Grid.Column="3"
                    Style="{StaticResource IconButtonStyle}"
                    Width="26"
                    Height="26"
                    Click="ExpandButton_Click"
                    ToolTipService.ToolTip="Open mixer">
                <FontIcon x:Name="ChevronIcon" Glyph="&#xE70E;" FontSize="10" />
            </Button>
        </Grid>

        <!-- Expanded App Sessions List -->
        <StackPanel x:Name="SessionsPanel" Grid.Row="1" Margin="0,10,0,4" Visibility="Collapsed" Spacing="8">
            <Border Height="1" Background="{ThemeResource AppMutedTextBrush}" Opacity="0.2" Margin="0,0,0,4" />
            <ListView x:Name="SessionsList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding VolumePercent, Mode=TwoWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding VolumePercentText}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" Opacity="0.7" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Window>
