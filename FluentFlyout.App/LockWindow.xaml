<Window x:Class="FluentFlyout.App.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource AppSurfaceBrush}"
          BorderBrush="{ThemeResource AppMutedTextBrush}"
          BorderThickness="0.5"
          CornerRadius="12"
          Padding="16,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Padlock icon -->
        <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource BrandAccentBrush}" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <FontIcon x:Name="LockIcon" Glyph="&#xE72E;" FontSize="16" Foreground="#081218" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- Key & State -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="KeyNameText" Text="Caps Lock" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" />
            <TextBlock x:Name="StateText" Text="On" FontSize="12" Opacity="0.75" Foreground="{ThemeResource AppMutedTextBrush}" />
        </StackPanel>
    </Grid>
</Window>
