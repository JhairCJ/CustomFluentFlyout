<Window
    x:Class="FluentFlyout.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentFlyout.App">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <Grid x:Name="TitleBar" Padding="20,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource BrandAccentBrush}">
                    <FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="#081218" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="FluentFlyout Settings" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AppTextBrush}" />
            </StackPanel>
        </Grid>

        <!-- Navigation View -->
        <NavigationView x:Name="Navigation"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="230"
                        SelectionChanged="Navigation_SelectionChanged">

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="SearchBox"
                                QueryIcon="Find"
                                PlaceholderText="Search settings..."
                                TextChanged="SearchBox_TextChanged"
                                SuggestionChosen="SearchBox_SuggestionChosen" />
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="Home" Icon="Home" />
                <NavigationViewItem Content="Media Flyout" Tag="Media" Icon="Play" />
                <NavigationViewItem Content="Volume Mixer" Tag="Volume" Icon="Volume" />
                <NavigationViewItem Content="Taskbar Widget" Tag="Widget" Icon="DockBottom" />
                <NavigationViewItem Content="Visualizer" Tag="Visualizer" Icon="Audio" />
                <NavigationViewItem Content="Next Up" Tag="NextUp" Icon="Message" />
                <NavigationViewItem Content="Lock Keys" Tag="LockKeys" Icon="Keyboard" />
                <NavigationViewItem Content="System" Tag="System" Icon="Setting" />
                <NavigationViewItem Content="App Filtering" Tag="Filtering" Icon="Filter" />
                <NavigationViewItem Content="Advanced" Tag="Advanced" Icon="Repair" />
                <NavigationViewItem Content="About" Tag="About" Icon="Help" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
