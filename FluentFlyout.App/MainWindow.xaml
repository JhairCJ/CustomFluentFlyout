<Window
    x:Class="FluentFlyout.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootContainer"
          PointerEntered="RootContainer_PointerEntered"
          PointerExited="RootContainer_PointerExited"
          CornerRadius="12"
          Background="{ThemeResource AppSurfaceBrush}"
          BorderBrush="{ThemeResource AppMutedTextBrush}"
          BorderThickness="0.5">

        <!-- Background Blur Art (Styles 1, 2, 3) -->
        <Image x:Name="BackgroundBlurImage"
               Stretch="UniformToFill"
               Opacity="0.25"
               IsHitTestVisible="False"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="Collapsed" />

        <!-- Main Content -->
        <Grid Padding="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Row: Artwork + Info & Controls -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Artwork Card -->
                <Border x:Name="ArtworkBorder"
                        Width="76"
                        Height="76"
                        CornerRadius="8"
                        Background="{ThemeResource BrandAccentSecondaryBrush}"
                        Margin="0,0,12,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <Grid>
                        <!-- Fallback icon -->
                        <FontIcon x:Name="FallbackIcon"
                                  Glyph="&#xE8D6;"
                                  FontSize="32"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        <!-- Album Art -->
                        <Image x:Name="ArtworkImage"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Track Info & Controls -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Close button in top right if always display or configured -->
                    <Button x:Name="CloseButton"
                            Style="{StaticResource IconButtonStyle}"
                            Width="26"
                            Height="26"
                            Padding="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="CloseButton_Click"
                            ToolTipService.ToolTip="Close flyout">
                        <FontIcon Glyph="&#xE8BB;" FontSize="11" />
                    </Button>

                    <!-- Title & Artist -->
                    <StackPanel Spacing="2" Margin="0,0,28,6">
                        <TextBlock x:Name="TitleText"
                                   Text="Nothing playing"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource AppTextBrush}" />
                        <TextBlock x:Name="ArtistText"
                                   Text="No active media session"
                                   FontSize="13"
                                   Opacity="0.65"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource AppMutedTextBrush}" />
                    </StackPanel>

                    <!-- Playback Controls -->
                    <StackPanel x:Name="ControlsPanel"
                                Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <!-- Previous -->
                        <Button x:Name="PreviousButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="PreviousButton_Click"
                                ToolTipService.ToolTip="Previous track">
                            <FontIcon Glyph="&#xE892;" FontSize="14" />
                        </Button>

                        <!-- Play / Pause -->
                        <Button x:Name="PlayPauseButton"
                                Style="{StaticResource AccentIconButtonStyle}"
                                Click="PlayPauseButton_Click"
                                ToolTipService.ToolTip="Play / Pause">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="14" />
                        </Button>

                        <!-- Next -->
                        <Button x:Name="NextButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="NextButton_Click"
                                ToolTipService.ToolTip="Next track">
                            <FontIcon Glyph="&#xE893;" FontSize="14" />
                        </Button>

                        <!-- Repeat -->
                        <Button x:Name="RepeatButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="RepeatButton_Click"
                                ToolTipService.ToolTip="Repeat">
                            <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="13" Opacity="0.6" />
                        </Button>

                        <!-- Shuffle -->
                        <Button x:Name="ShuffleButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="ShuffleButton_Click"
                                ToolTipService.ToolTip="Shuffle">
                            <FontIcon x:Name="ShuffleIcon" Glyph="&#xE8B1;" FontSize="13" Opacity="0.6" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Bottom Row: Seekbar (optional / expandable) -->
            <Grid x:Name="SeekbarPanel" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CurrentTimeText" Text="0:00" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider x:Name="TimelineSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" ValueChanged="TimelineSlider_ValueChanged" />
                <TextBlock x:Name="TotalDurationText" Grid.Column="2" Text="0:00" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
        </Grid>
    </Grid>
</Window>
