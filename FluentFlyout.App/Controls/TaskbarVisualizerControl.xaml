<UserControl
    x:Class="FluentFlyout.App.Controls.TaskbarVisualizerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="40">

    <Border x:Name="MainBorder" CornerRadius="6" Background="#FF202020"
            PointerEntered="MainBorder_PointerEntered" PointerExited="MainBorder_PointerExited"
            Tapped="MainBorder_Tapped">
        <Border x:Name="TopBorder" BorderThickness="0,1.25,0,0" CornerRadius="5" Margin="0,0,0,1.25"
                BorderBrush="Transparent">
            <Grid>
                <!-- Hover highlight overlay, faded in/out by the hover animation. -->
                <Border x:Name="HoverOverlay" CornerRadius="5" Background="#FFFFFFFF" Opacity="0" IsHitTestVisible="False" />
                <Canvas x:Name="BarsCanvas" Width="120" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Border>
</UserControl>
