<UserControl x:Class="FluentFlyout.App.Controls.SettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource AppSurfaceBrush}" CornerRadius="14" Padding="18">
        <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="DescriptionText" Opacity="0.7" TextWrapping="Wrap"/>
            </StackPanel>
            <ContentPresenter x:Name="ContentHost" Grid.Column="1" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
