<Page x:Class="FluentFlyoutWPF.Pages.DictationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
      xmlns:viewModels="clr-namespace:FluentFlyoutWPF.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="800"
      Title="DictationPage"
      d:DataContext="{d:DesignInstance viewModels:UserSettings}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      d:Background="White">

    <StackPanel MaxWidth="1000" Margin="16">
        <ui:CardControl x:Name="DictationHistoryCard" Tag="Indexable" Icon="{ui:SymbolIcon Folder24}" Margin="0,0,0,20">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{DynamicResource DictationHistoryTitle}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource DictationHistoryDescription}" FontSize="12" Opacity="0.65"
                               TextWrapping="Wrap" MaxWidth="520" />
                    <TextBlock x:Name="HistoryStatus" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0" />
                </StackPanel>
            </ui:CardControl.Header>
            <Button Content="{DynamicResource DictationHistoryOpen}" Click="OpenTranscriptions_Click" />
        </ui:CardControl>

        <TextBlock Text="{DynamicResource DictationTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20" />
        <TextBlock Text="{DynamicResource DictationDescription}" FontSize="14" FontWeight="Regular"
                   Opacity="0.75" TextWrapping="WrapWithOverflow" MaxWidth="720" Margin="0,0,0,20" />

        <ui:CardControl x:Name="DictationEnableCard" Tag="Indexable" Icon="{ui:SymbolIcon Mic24}" Margin="0,0,0,12">
            <ui:CardControl.Header>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{DynamicResource DictationEnableTitle}" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource DictationEnableDescription}" FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="520" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding DictationEnabled, Mode=TwoWay}" />
        </ui:CardControl>

        <ui:CardControl x:Name="DictationResourceCard" Tag="Indexable" Margin="0,0,0,12">
            <ui:CardControl.Header>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{DynamicResource DictationResourceTitle}" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource DictationResourceDescription}" FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="520" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Width="560">
                <ui:ToggleSwitch IsChecked="{Binding DictationKeepModelLoaded, Mode=TwoWay}"
                                 Content="{DynamicResource DictationKeepModelLoaded}" />
                <StackPanel Margin="0,10,0,0" IsEnabled="{Binding DictationAutoReleaseEnabled}">
                    <TextBlock Text="{DynamicResource DictationUnloadDelayTitle}" FontSize="13" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                        <Slider Width="260" Minimum="15" Maximum="600" TickFrequency="15"
                                IsSnapToTickEnabled="True"
                                Value="{Binding DictationUnloadDelaySeconds, Mode=TwoWay}" />
                        <TextBlock Text="{Binding DictationUnloadDelayText}" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource DictationUnloadDelayDescription}" FontSize="11" Opacity="0.6"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl x:Name="DictationHotkeyCard" Tag="Indexable" Icon="{ui:SymbolIcon Keyboard24}" Margin="0,0,0,12">
            <ui:CardControl.Header>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{DynamicResource DictationHotkeyTitle}" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource DictationHotkeyDescription}" FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="520" />
                </StackPanel>
            </ui:CardControl.Header>
            <!-- Caja de captura: se hace clic, se pulsa la tecla o combinación y se queda
                 escrita. Solo lee teclas (IsReadOnly): aquí no se escribe texto. -->
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="HotkeyBox" Width="200" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         FontWeight="SemiBold" TextAlignment="Center"
                         Text="{Binding DictationHotkey, Mode=OneWay}"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" PreviewKeyUp="HotkeyBox_PreviewKeyUp"
                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                         LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                         ToolTip="{DynamicResource DictationHotkeyTip}" />
                <TextBlock Text="{DynamicResource DictationHotkeyHint}" FontSize="12" Opacity="0.5"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl x:Name="DictationModeCard" Tag="Indexable" Icon="{ui:SymbolIcon Mic24}" Margin="0,0,0,12">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{DynamicResource DictationToggleTitle}" FontSize="14" />
                    <TextBlock Text="{DynamicResource DictationToggleDescription}" FontSize="12" Opacity="0.5"
                               TextWrapping="Wrap" MaxWidth="520" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding DictationToggleMode, Mode=TwoWay}" />
        </ui:CardControl>

        <ui:CardControl x:Name="DictationLanguageCard" Tag="Indexable" Icon="{ui:SymbolIcon LocalLanguage24}" Margin="0,0,0,12">
            <ui:CardControl.Header>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{DynamicResource DictationLanguageTitle}" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource DictationLanguageDescription}" FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="520" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="LanguageCombo" Width="200" SelectionChanged="LanguageCombo_SelectionChanged">
                <ComboBoxItem Content="{DynamicResource DictationLanguageAuto}" />
                <ComboBoxItem Content="{DynamicResource DictationLanguageSpanish}" />
                <ComboBoxItem Content="{DynamicResource DictationLanguageEnglish}" />
            </ComboBox>
        </ui:CardControl>

        <ui:CardExpander x:Name="DictationRuntimesCard" Tag="Indexable" Margin="0,0,0,12"
                         Icon="{ui:SymbolIcon Wrench24}" ContentPadding="20" IsExpanded="False">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Text="{DynamicResource DictationRuntimeTitle}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource DictationRuntimeDescription}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </ui:CardExpander.Header>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Whisper · NVIDIA CUDA 13" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource DictationWhisperCudaDescription}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="WhisperCudaRuntimeStatus" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="WhisperCudaRuntimeButton" Content="{DynamicResource DictationRuntimeDownload}"
                                MinWidth="112" Padding="12,6" Click="DownloadWhisperCudaRuntime_Click" />
                        <Button x:Name="WhisperCudaRuntimeRemoveButton" Content="{DynamicResource DictationRuntimeUninstall}"
                                MinWidth="112" Padding="12,6" Visibility="Collapsed" Click="UninstallWhisperCudaRuntime_Click" />
                        <Button x:Name="WhisperCudaRuntimeCancelButton" Content="{DynamicResource DictationRuntimeCancel}"
                                MinWidth="112" Padding="12,6" Visibility="Collapsed" Click="CancelWhisperCudaRuntime_Click" />
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="WhisperCudaRuntimeProgress" Minimum="0" Maximum="100" Height="4"
                             Margin="0,12,0,0" Visibility="Collapsed" />
                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultSolidBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,16" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="NeMo-Speech.cpp" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource DictationRuntimeNemoDescription}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="NemoRuntimeStatus" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="NemoRuntimeButton" Content="{DynamicResource DictationRuntimeDownload}"
                                MinWidth="112" Padding="12,6" Click="InstallNemoRuntime_Click" />
                        <Button x:Name="NemoRuntimeRemoveButton" Content="{DynamicResource DictationRuntimeUninstall}"
                                MinWidth="112" Padding="12,6" Visibility="Collapsed" Click="UninstallNemoRuntime_Click" />
                    </StackPanel>
                </Grid>
                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultSolidBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,16" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource DictationRuntimeVulkanTitle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource DictationRuntimeVulkanDescription}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="CrispAsrRuntimeStatus" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="CrispAsrRuntimeButton" Content="{DynamicResource DictationRuntimeDownload}"
                                MinWidth="112" Padding="12,6" Click="DownloadCrispAsrRuntime_Click" />
                        <Button x:Name="CrispAsrRuntimeRemoveButton" Content="{DynamicResource DictationRuntimeUninstall}"
                                MinWidth="112" Padding="12,6" Visibility="Collapsed" Click="UninstallCrispAsrRuntime_Click" />
                    </StackPanel>
                </Grid>
                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultSolidBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,16" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Parakeet Ultra · NVIDIA CUDA 12" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource DictationRuntimeCuda12Description}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="CrispAsrCudaRuntimeStatus" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="CrispAsrCudaRuntimeButton" Content="{DynamicResource DictationRuntimeDownload}"
                                MinWidth="112" Padding="12,6" Click="DownloadCrispAsrCudaRuntime_Click" />
                        <Button x:Name="CrispAsrCudaRuntimeRemoveButton" Content="{DynamicResource DictationRuntimeUninstall}"
                                MinWidth="112" Padding="12,6" Visibility="Collapsed" Click="UninstallCrispAsrCudaRuntime_Click" />
                    </StackPanel>
                </Grid>
                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultSolidBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,16" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Parakeet Ultra · NVIDIA CUDA 13" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource DictationRuntimeCuda13Description}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="CrispAsrCuda13RuntimeStatus" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="CrispAsrCuda13RuntimeButton" Content="{DynamicResource DictationRuntimeDownload}"
                                MinWidth="112" Padding="12,6" Click="DownloadCrispAsrCuda13Runtime_Click" />
                        <Button x:Name="CrispAsrCuda13RuntimeRemoveButton" Content="{DynamicResource DictationRuntimeUninstall}"
                                MinWidth="112" Padding="12,6" Visibility="Collapsed" Click="UninstallCrispAsrCuda13Runtime_Click" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{DynamicResource DictationRuntimeRemovalHint}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,20,0,0" />
                <TextBlock x:Name="RuntimesStatus" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </ui:CardExpander>

        <ui:Card x:Name="DictationModelsCard" Tag="Indexable" Margin="0,0,0,12"
                 Padding="20" HorizontalContentAlignment="Stretch"
                 Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                 BorderBrush="{DynamicResource CardStrokeColorDefaultSolidBrush}">
            <!-- La lista la rellena el código (DictationPage.xaml.cs): mezcla el catálogo
                 descargable con los archivos que ya haya en la carpeta de modelos. -->
            <StackPanel>
                <StackPanel Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20" Margin="0,0,12,0" />
                        <TextBlock Text="{DynamicResource DictationModelsTitle}" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource DictationModelsDescription}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{DynamicResource DictationDeviceHint}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock x:Name="GpuRuntimeStatus" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Button x:Name="CudaDriverButton" Content="{DynamicResource DictationGpuDownloadDrivers}"
                            Padding="12,4" Margin="0,8,0,0" HorizontalAlignment="Left"
                            Visibility="Collapsed" Click="DownloadCudaDrivers_Click" />
                </StackPanel>
                <ItemsControl x:Name="ModelList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DeviceText}" FontSize="12" Margin="0,4,0,0"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" TextWrapping="Wrap"
                                               Visibility="{Binding Active, Converter={StaticResource BoolToVisibleCollapsedConverter}}" />
                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,4,0,0"
                                                 Visibility="{Binding Busy, Converter={StaticResource BoolToVisibleCollapsedConverter}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource DictationModelActive}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding Active, Converter={StaticResource BoolToVisibleCollapsedConverter}}" />
                                    <ui:Button Padding="8" Margin="8,0,0,0" MinWidth="36" MinHeight="36"
                                            ToolTip="{DynamicResource DictationDeviceSettings}"
                                            AutomationProperties.Name="{DynamicResource DictationDeviceSettings}"
                                            Click="ModelSettings_Click"
                                            Visibility="{Binding Active, Converter={StaticResource BoolToVisibleCollapsedConverter}}">
                                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" />
                                    </ui:Button>
                                    <Button Content="{DynamicResource DictationModelUse}" Padding="12,4" Margin="8,0,0,0"
                                            Click="UseModel_Click"
                                            Visibility="{Binding CanUse, Converter={StaticResource BoolToVisibleCollapsedConverter}}" />
                                    <Button Content="{DynamicResource DictationModelDownload}" Padding="12,4" Margin="8,0,0,0"
                                            Click="DownloadModel_Click"
                                            Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibleCollapsedConverter}}" />
                                    <Button Content="{DynamicResource DictationModelDelete}" Padding="12,4" Margin="8,0,0,0"
                                            Click="DeleteModel_Click"
                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibleCollapsedConverter}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="{DynamicResource DictationModelAddLocal}" Padding="12,4" Click="AddLocalModel_Click" />
                    <Button Content="{DynamicResource DictationModelOpenFolder}" Padding="12,4" Margin="8,0,0,0" Click="OpenFolder_Click" />
                    <TextBlock x:Name="ModelsStatus" FontSize="12" Opacity="0.7" VerticalAlignment="Center"
                               Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                </WrapPanel>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
