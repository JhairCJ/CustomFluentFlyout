                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{DynamicResource IslandPage_ShelfTitle}" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource IslandPage_ShelfDesc}" FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="440" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IslandShelfEnabled, Mode=TwoWay}" Margin="0,0,16,0" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel Margin="0,8,0,8">
                    <ListBox ItemsSource="{Binding IslandShelfItems}" MaxHeight="240" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="{Binding Glyph}" Filled="True" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <!-- El nombre del archivo o de la carpeta es lo que
                                             identifica al elemento: el tipo ya lo dice el
                                             glifo y la extensión no aportaba nada. -->
                                        <TextBlock Width="300" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Content="{DynamicResource IslandPage_Remove}" Click="IslandShelfItemRemove_Click" Padding="8,2" Margin="12,0,0,0" ToolTip="{DynamicResource IslandPage_ShelfItemRemoveTip}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DisplayPath}" FontSize="11" Opacity="0.5" Margin="22,2,4,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{DynamicResource IslandPage_ParkFiles}" Click="IslandShelfAdd_Click" Padding="12,4" ToolTip="{DynamicResource IslandPage_ParkFilesTip}" />
                        <Button Content="{DynamicResource IslandPage_OpenFolder}" Click="IslandShelfOpenFolder_Click" Padding="12,4" Margin="8,0,0,0" />
                        <Button Content="{DynamicResource IslandPage_ClearShelf}" Click="IslandShelfClear_Click" Padding="12,4" Margin="8,0,0,0" ToolTip="{DynamicResource IslandPage_ClearShelfTip}" />
                        <TextBlock Text="{Binding IslandShelfError}" Foreground="#E81123" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>
            <TextBlock Tag="Tools" Grid.Row="50" Text="{DynamicResource IslandPage_CalendarSection}" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" />
            <!-- Google Calendar: el inicio de sesión se hace desde aquí (navegador + bucle
                 local); los tokens se guardan con los ajustes. La app necesita el cliente
                 OAuth del propio usuario: no se reparte ninguno. -->
            <ui:CardExpander x:Name="IslandCalendarCard" Tag="Tools" Grid.Row="51" Icon="{ui:SymbolIcon Calendar24}" ContentPadding="0" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardExpander.Header>
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{DynamicResource IslandPage_CalendarTitle}" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource IslandPage_CalendarDesc}" FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="440" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IslandCalendarEnabled, Mode=TwoWay}" Margin="0,0,16,0" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel Margin="0,8,0,8">
                    <TextBlock Text="{DynamicResource IslandPage_CalendarOAuthNote}"
                               FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" Margin="0,0,0,10" MaxWidth="520" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource IslandPage_ClientId}" Width="120" VerticalAlignment="Center" FontSize="14" />
                        <ui:TextBox Width="360" ClearButtonEnabled="False"
                                    Text="{Binding GoogleCalendarClientId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource IslandPage_ClientSecret}" Width="120" VerticalAlignment="Center" FontSize="14" />
                        <ui:TextBox Width="360" ClearButtonEnabled="False"
                                    Text="{Binding GoogleCalendarClientSecret, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="{DynamicResource IslandPage_SignInGoogle}" Click="GoogleCalendarSignIn_Click" Padding="12,4" />
                        <Button Content="{DynamicResource IslandPage_SignOut}" Click="GoogleCalendarSignOut_Click" Padding="12,4" Margin="8,0,0,0" />
                        <Button Content="{DynamicResource IslandPage_SyncNow}" Click="GoogleCalendarRefresh_Click" Padding="12,4" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource IslandPage_ConnectedAccount}" FontSize="12" Opacity="0.5" Margin="0,10,0,2" />
                    <TextBlock Text="{Binding GoogleCalendarAccount}" FontSize="13" />
                    <TextBlock Text="{Binding GoogleCalendarStatus}" FontSize="12" Opacity="0.7" Margin="0,4,0,0" TextWrapping="WrapWithOverflow" MaxWidth="520" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding GoogleCalendarError}" Foreground="#E81123" FontSize="12" Margin="0,4,0,0" TextWrapping="WrapWithOverflow" MaxWidth="520" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{DynamicResource IslandPage_RemindBefore}" Width="120" VerticalAlignment="Center" FontSize="14" />
                        <Slider Minimum="1" Maximum="60" Value="{Binding GoogleCalendarReminderMinutes, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Width="150" />
                        <ui:TextBlock Text="{Binding GoogleCalendarReminderMinutes}" Width="24" TextAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Text="min" VerticalAlignment="Center" Opacity="0.6" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource IslandPage_SyncEvery}" Width="120" VerticalAlignment="Center" FontSize="14" />
                        <Slider Minimum="1" Maximum="60" Value="{Binding GoogleCalendarRefreshMinutes, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Width="150" />
                        <ui:TextBlock Text="{Binding GoogleCalendarRefreshMinutes}" Width="24" TextAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Text="min" VerticalAlignment="Center" Opacity="0.6" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource IslandPage_ReadAhead}" Width="120" VerticalAlignment="Center" FontSize="14" />
                        <Slider Minimum="1" Maximum="14" Value="{Binding GoogleCalendarDaysAhead, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Width="150" />
                        <ui:TextBlock Text="{Binding GoogleCalendarDaysAhead}" Width="24" TextAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Text="{DynamicResource IslandPage_Days}" VerticalAlignment="Center" Opacity="0.6" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource IslandPage_CalendarNote}"
                               FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" Margin="0,10,0,0" MaxWidth="520" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:CardExpander>
            <TextBlock Tag="Tools" Grid.Row="52" Text="{DynamicResource IslandPage_BluetoothSection}" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" />
            <!-- Bluetooth: solo se observan conexiones (nada se envía ni se modifica) y
                 el aviso es SIEMPRE temporal, con la duración del aviso configurada,
                 aunque el contenedor esté en «Visible mientras activo». -->
            <ui:CardExpander x:Name="IslandBluetoothCard" Tag="Tools" Grid.Row="53" Icon="{ui:SymbolIcon Bluetooth24}" ContentPadding="0" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardExpander.Header>
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{DynamicResource IslandPage_BluetoothTitle}" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource IslandPage_BluetoothDesc}" FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="440" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IslandBluetoothEnabled, Mode=TwoWay}" Margin="0,0,16,0" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel Margin="0,8,0,8">
                    <TextBlock Text="{DynamicResource IslandPage_BluetoothNote}"
                               FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="520" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:CardExpander>
            <TextBlock Tag="Tools" Grid.Row="54" Text="{DynamicResource IslandPage_ClipboardSection}" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" />
            <!-- Portapapeles: solo se observa lo que el usuario copia (nada se envía ni
                 se modifica; el original se conserva intacto) y su vista vive en el
                 Island, donde un clic devuelve la pieza al portapapeles para pegarla. -->
            <ui:CardExpander x:Name="IslandClipboardCard" Tag="Tools" Grid.Row="55" Icon="{ui:SymbolIcon Clipboard24}" ContentPadding="0" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardExpander.Header>
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{DynamicResource IslandPage_ClipboardTitle}" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource IslandPage_ClipboardDesc}" FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="440" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IslandClipboardEnabled, Mode=TwoWay}" Margin="0,0,16,0" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel Margin="0,8,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource IslandPage_Keep}" Width="120" VerticalAlignment="Center" FontSize="14" />
                        <Slider Minimum="1" Maximum="100" Value="{Binding IslandClipboardMaxItems, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Width="150" />
                        <ui:TextBlock Text="{Binding IslandClipboardMaxItems}" Width="24" TextAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Text="{DynamicResource IslandPage_Pieces}" VerticalAlignment="Center" Opacity="0.6" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource IslandPage_ClipboardNote}"
                               FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" Margin="0,10,0,0" MaxWidth="520" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:CardExpander>
            <TextBlock Tag="Tools" Grid.Row="56" Text="{DynamicResource IslandPage_WeatherSection}" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" />
            <!-- Clima: el lugar se busca y se elige entre las sugerencias (así no hay
                 que teclear coordenadas ni elegir entre dos pueblos con el mismo
                 nombre); el dato lo lee el Island y no se envía nada más que el lugar. -->
            <ui:CardExpander x:Name="IslandWeatherCard" Tag="Tools" Grid.Row="57" Icon="{ui:SymbolIcon WeatherSunny24}" ContentPadding="0" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardExpander.Header>
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{DynamicResource IslandPage_WeatherTitle}" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource IslandPage_WeatherDesc}" FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="440" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IslandWeatherEnabled, Mode=TwoWay}" Margin="0,0,16,0" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel Margin="0,8,0,8">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox x:Name="IslandWeatherSearch" Width="260" PlaceholderText="{DynamicResource IslandPage_WeatherPlaceholder}"
                                    KeyDown="IslandWeatherSearch_KeyDown" />
                        <Button x:Name="IslandWeatherSearchBtn" Content="{DynamicResource IslandPage_Search}" Click="IslandWeatherSearch_Click"
                                Padding="12,4" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="IslandWeatherSearchHint" Text="{DynamicResource IslandPage_WeatherHint}"
                               FontSize="12" Opacity="0.5" Margin="0,6,0,0" TextWrapping="WrapWithOverflow" MaxWidth="520" HorizontalAlignment="Left" />
                    <!-- Sugerencias del buscador: se rellenan al buscar (código) para poder
                         enseñar nombre, región y país de cada una. -->
                    <StackPanel x:Name="IslandWeatherPlaces" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="IslandWeatherPlaceText" Text="{DynamicResource IslandPage_NoPlace}" FontSize="13" VerticalAlignment="Center" />
                        <Button Content="{DynamicResource IslandPage_RefreshNow}" Click="IslandWeatherRefresh_Click" Padding="12,4" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="IslandWeatherStatusText" Text="{Binding IslandWeatherStatus}" FontSize="12" Opacity="0.5" Margin="0,8,0,0" TextWrapping="WrapWithOverflow" MaxWidth="520" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding IslandWeatherError}" FontSize="12" Foreground="#FF6B6B" Margin="0,4,0,0" TextWrapping="WrapWithOverflow" MaxWidth="520" HorizontalAlignment="Left" />
                    <TextBlock Text="{DynamicResource IslandPage_WeatherNote}"
                               FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" Margin="0,10,0,0" MaxWidth="520" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:CardExpander>
            <TextBlock Tag="Tools" Grid.Row="58" Text="{DynamicResource IslandPage_PowerSection}" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" />
            <!-- Cargador: solo se observa el estado de energía que ya conoce Windows (nada
                 se envía ni se modifica) y el aviso es SIEMPRE temporal, con la duración
                 del aviso configurada. -->
            <ui:CardExpander x:Name="IslandPowerCard" Tag="Tools" Grid.Row="59" Icon="{ui:SymbolIcon BatteryCharge24}" ContentPadding="0" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardExpander.Header>
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{DynamicResource IslandPage_PowerTitle}" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource IslandPage_PowerDesc}" FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="440" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IslandPowerEnabled, Mode=TwoWay}" Margin="0,0,16,0" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel Margin="0,8,0,8">
                    <TextBlock Text="{DynamicResource IslandPage_PowerNote}"
                               FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="520" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:CardExpander>
            <TextBlock Tag="Tools" Grid.Row="60" Text=" " FontSize="8" Margin="0,0,0,72" /> 
        </Grid>
    </StackPanel>
</Page>
