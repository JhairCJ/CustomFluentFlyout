                 varias están activas a la vez. El ajuste se guarda solo (UserSettings.MoveIslandFeature)
                 y el contenedor lo aplica en el acto, sin reiniciar. -->
            <ui:CardExpander x:Name="IslandOrderCard" Tag="Indexable" Grid.Row="46" Icon="{ui:SymbolIcon ArrowSort24}" ContentPadding="0" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardExpander.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Orden de la lista" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="Orden en el que la rueda del ratón y las flechas recorren las funcionalidades. Las deshabilitadas se saltan, pero conservan su sitio." FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="440" HorizontalAlignment="Left" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <ItemsControl ItemsSource="{Binding IslandFeatureOrder}" Margin="0,8,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14"
                                           Text="{Binding Converter={StaticResource IslandFeatureNameConverter}}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Click="IslandFeatureMoveUp_Click" Padding="8,2" Margin="0,0,4,0" ToolTip="Subir en la lista">
                                        <ui:SymbolIcon Symbol="ArrowUp24" FontSize="12" />
                                    </Button>
                                    <Button Click="IslandFeatureMoveDown_Click" Padding="8,2" ToolTip="Bajar en la lista">
                                        <ui:SymbolIcon Symbol="ArrowDown24" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:CardExpander>
            <TextBlock Grid.Row="47" Text="Estante de archivos" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" />
            <!-- Estante: los archivos se MUEVEN a la carpeta propia del estante y quitarlos los
                 devuelve a su carpeta original. Nada caduca y nada se borra desde aquí. -->
            <ui:CardExpander x:Name="IslandShelfCard" Tag="Indexable" Grid.Row="48" Icon="{ui:SymbolIcon Folder24}" ContentPadding="0" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardExpander.Header>
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Estante del Island" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                            <TextBlock Text="Suelta archivos o carpetas sobre el Island para aparcarlos y arrástralos desde ahí para sacarlos. No caducan: quitarlos los devuelve a su carpeta original (máx. 24)." FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="440" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IslandShelfEnabled, Mode=TwoWay}" Margin="0,0,16,0" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel Margin="0,8,0,8">
                    <ListBox ItemsSource="{Binding IslandShelfItems}" MaxHeight="240" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="{Binding Glyph}" Filled="True" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Width="240" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Badge}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <Button Content="Quitar" Click="IslandShelfItemRemove_Click" Padding="8,2" Margin="12,0,0,0" ToolTip="Lo devuelve a su carpeta original" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DisplayPath}" FontSize="11" Opacity="0.5" Margin="22,2,4,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Aparcar archivos…" Click="IslandShelfAdd_Click" Padding="12,4" ToolTip="Los mueve al estante" />
                        <Button Content="Abrir carpeta" Click="IslandShelfOpenFolder_Click" Padding="12,4" Margin="8,0,0,0" />
                        <Button Content="Vaciar estante" Click="IslandShelfClear_Click" Padding="12,4" Margin="8,0,0,0" ToolTip="Devuelve cada elemento a su carpeta original" />
                        <TextBlock Text="{Binding IslandShelfError}" Foreground="#E81123" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>
            <TextBlock Grid.Row="49" Text="Recordatorios de calendario" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" />
            <!-- Google Calendar: el inicio de sesión se hace desde aquí (navegador + bucle
                 local); los tokens se guardan con los ajustes. La app necesita el cliente
                 OAuth del propio usuario: no se reparte ninguno. -->
            <ui:CardExpander x:Name="IslandCalendarCard" Tag="Indexable" Grid.Row="50" Icon="{ui:SymbolIcon Calendar24}" ContentPadding="0" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardExpander.Header>
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Recordatorios de Google Calendar" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                            <TextBlock Text="Avisa en el Island cuando un evento del calendario está a punto de empezar (solo lectura de tu calendario principal)." FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="440" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IslandCalendarEnabled, Mode=TwoWay}" Margin="0,0,16,0" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel Margin="0,8,0,8">
                    <TextBlock Text="Hace falta un cliente OAuth propio: en Google Cloud Console crea uno de tipo «Aplicación de escritorio», habilita la API de Google Calendar y añade tu cuenta como usuario de prueba. Pega aquí su id y su secreto."
                               FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" Margin="0,0,0,10" MaxWidth="520" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Id de cliente" Width="120" VerticalAlignment="Center" FontSize="14" />
                        <ui:TextBox Width="360" ClearButtonEnabled="False"
                                    Text="{Binding GoogleCalendarClientId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Secreto de cliente" Width="120" VerticalAlignment="Center" FontSize="14" />
                        <ui:TextBox Width="360" ClearButtonEnabled="False"
                                    Text="{Binding GoogleCalendarClientSecret, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Iniciar sesión con Google" Click="GoogleCalendarSignIn_Click" Padding="12,4" />
                        <Button Content="Cerrar sesión" Click="GoogleCalendarSignOut_Click" Padding="12,4" Margin="8,0,0,0" />
                        <Button Content="Sincronizar ahora" Click="GoogleCalendarRefresh_Click" Padding="12,4" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Cuenta conectada" FontSize="12" Opacity="0.5" Margin="0,10,0,2" />
                    <TextBlock Text="{Binding GoogleCalendarAccount}" FontSize="13" />
                    <TextBlock Text="{Binding GoogleCalendarStatus}" FontSize="12" Opacity="0.7" Margin="0,4,0,0" TextWrapping="WrapWithOverflow" MaxWidth="520" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding GoogleCalendarError}" Foreground="#E81123" FontSize="12" Margin="0,4,0,0" TextWrapping="WrapWithOverflow" MaxWidth="520" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Avisar antes" Width="120" VerticalAlignment="Center" FontSize="14" />
                        <Slider Minimum="1" Maximum="60" Value="{Binding GoogleCalendarReminderMinutes, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Width="150" />
                        <ui:TextBlock Text="{Binding GoogleCalendarReminderMinutes}" Width="24" TextAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Text="min" VerticalAlignment="Center" Opacity="0.6" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Sincronizar cada" Width="120" VerticalAlignment="Center" FontSize="14" />
                        <Slider Minimum="1" Maximum="60" Value="{Binding GoogleCalendarRefreshMinutes, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Width="150" />
                        <ui:TextBlock Text="{Binding GoogleCalendarRefreshMinutes}" Width="24" TextAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Text="min" VerticalAlignment="Center" Opacity="0.6" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Leer hasta" Width="120" VerticalAlignment="Center" FontSize="14" />
                        <Slider Minimum="1" Maximum="14" Value="{Binding GoogleCalendarDaysAhead, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Width="150" />
                        <ui:TextBlock Text="{Binding GoogleCalendarDaysAhead}" Width="24" TextAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Text="días" VerticalAlignment="Center" Opacity="0.6" />
                    </StackPanel>
                    <TextBlock Text="Es un recordatorio: el próximo evento se lee del calendario principal y el aviso aparece en el Island solo con la sesión iniciada. Cerrar sesión no borra nada del calendario."
                               FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" Margin="0,10,0,0" MaxWidth="520" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:CardExpander>
            <TextBlock Grid.Row="51" Text="Dispositivos Bluetooth" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" />
            <!-- Bluetooth: solo se observan conexiones (nada se envía ni se modifica) y
                 el aviso es SIEMPRE temporal, con la duración del aviso configurada,
                 aunque el contenedor esté en «Visible mientras activo». -->
            <ui:CardExpander x:Name="IslandBluetoothCard" Tag="Indexable" Grid.Row="52" Icon="{ui:SymbolIcon Bluetooth24}" ContentPadding="0" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardExpander.Header>
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Dispositivos Bluetooth conectados" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                            <TextBlock Text="Avisa en el Island cuando un dispositivo Bluetooth se conecta: su icono, su nombre y su batería si el dispositivo la informa. El aviso siempre es temporal y se retira al vencer la duración configurada." FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="440" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IslandBluetoothEnabled, Mode=TwoWay}" Margin="0,0,16,0" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel Margin="0,8,0,8">
                    <TextBlock Text="La batería solo se muestra si Windows la conoce para ese dispositivo (auriculares y altavoces que la informan); los que no la informan salen sin aro y sin nada en esa zona. Una conexión no interrumpe una vista expandida que estés mirando ni aparece sobre un juego a pantalla completa."
                               FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="520" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:CardExpander>
            <TextBlock Grid.Row="53" Text="Portapapeles" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" />
            <!-- Portapapeles: solo se observa lo que el usuario copia (nada se envía ni
                 se modifica; el original se conserva intacto) y su vista vive en el
                 Island, donde un clic devuelve la pieza al portapapeles para pegarla. -->
            <ui:CardExpander x:Name="IslandClipboardCard" Tag="Indexable" Grid.Row="54" Icon="{ui:SymbolIcon Clipboard24}" ContentPadding="0" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardExpander.Header>
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Historial del portapapeles" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                            <TextBlock Text="Todo lo que copies (texto o imagen) queda en el Island: haz clic en una pieza y se copia de nuevo para pegarla con Ctrl+V donde quieras." FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="440" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IslandClipboardEnabled, Mode=TwoWay}" Margin="0,0,16,0" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel Margin="0,8,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Guardar" Width="120" VerticalAlignment="Center" FontSize="14" />
                        <Slider Minimum="1" Maximum="100" Value="{Binding IslandClipboardMaxItems, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Width="150" />
                        <ui:TextBlock Text="{Binding IslandClipboardMaxItems}" Width="24" TextAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Text="piezas" VerticalAlignment="Center" Opacity="0.6" />
                    </StackPanel>
                    <TextBlock Text="Lo guardado vive solo en memoria: se pierde al cerrar la app y nunca sale de tu equipo. Al bajar el tope se descartan las piezas más viejas."
                               FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" Margin="0,10,0,0" MaxWidth="520" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:CardExpander>
            <TextBlock Grid.Row="55" Text="Clima" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" />
            <!-- Clima: el lugar se busca y se elige entre las sugerencias (así no hay
                 que teclear coordenadas ni elegir entre dos pueblos con el mismo
                 nombre); el dato lo lee el Island y no se envía nada más que el lugar. -->
            <ui:CardExpander x:Name="IslandWeatherCard" Tag="Indexable" Grid.Row="56" Icon="{ui:SymbolIcon WeatherSunny24}" ContentPadding="0" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardExpander.Header>
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Clima del lugar que elijas" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                            <TextBlock Text="Muestra el clima actual en el Island: el glifo del cielo y la temperatura en compacto, y el lugar, el estado y los extremos del día en expandido. Se actualiza solo cada cuarto de hora." FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="440" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IslandWeatherEnabled, Mode=TwoWay}" Margin="0,0,16,0" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel Margin="0,8,0,8">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox x:Name="IslandWeatherSearch" Width="260" PlaceholderText="Ciudad o lugar (p. ej. Vigo)"
                                    KeyDown="IslandWeatherSearch_KeyDown" />
                        <Button x:Name="IslandWeatherSearchBtn" Content="Buscar" Click="IslandWeatherSearch_Click"
                                Padding="12,4" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="IslandWeatherSearchHint" Text="Escribe al menos dos letras y busca: elige el lugar correcto entre las sugerencias."
                               FontSize="12" Opacity="0.5" Margin="0,6,0,0" TextWrapping="WrapWithOverflow" MaxWidth="520" HorizontalAlignment="Left" />
                    <!-- Sugerencias del buscador: se rellenan al buscar (código) para poder
                         enseñar nombre, región y país de cada una. -->
                    <StackPanel x:Name="IslandWeatherPlaces" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="IslandWeatherPlaceText" Text="Sin lugar elegido" FontSize="13" VerticalAlignment="Center" />
                        <Button Content="Actualizar ahora" Click="IslandWeatherRefresh_Click" Padding="12,4" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="IslandWeatherStatusText" Text="{Binding IslandWeatherStatus}" FontSize="12" Opacity="0.5" Margin="0,8,0,0" TextWrapping="WrapWithOverflow" MaxWidth="520" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding IslandWeatherError}" FontSize="12" Foreground="#FF6B6B" Margin="0,4,0,0" TextWrapping="WrapWithOverflow" MaxWidth="520" HorizontalAlignment="Left" />
                    <TextBlock Text="El lugar viaja a Open-Meteo (servicio meteorológico abierto, sin cuenta ni clave): es lo único que sale de tu equipo. Apagado no se consulta nada."
                               FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" Margin="0,10,0,0" MaxWidth="520" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:CardExpander>
            <TextBlock Grid.Row="57" Text="Energía" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" />
            <!-- Cargador: solo se observa el estado de energía que ya conoce Windows (nada
                 se envía ni se modifica) y el aviso es SIEMPRE temporal, con la duración
                 del aviso configurada. -->
            <ui:CardExpander x:Name="IslandPowerCard" Tag="Indexable" Grid.Row="58" Icon="{ui:SymbolIcon BatteryCharge24}" ContentPadding="0" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardExpander.Header>
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Cargador conectado y desconectado" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                            <TextBlock Text="Avisa en el Island cuando el equipo se enchufa a la corriente (rayo verde y porcentaje de batería) y cuando se queda a batería (rayo rojo y el último porcentaje). El aviso siempre es temporal." FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="440" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IslandPowerEnabled, Mode=TwoWay}" Margin="0,0,16,0" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel Margin="0,8,0,8">
                    <TextBlock Text="Un equipo sin batería (un sobremesa) no avisa: ahí enchufar o desenchufar no significa nada. Sin nivel conocido se enseña el texto sin el porcentaje, en vez de un 0 % inventado."
                               FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="520" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:CardExpander>
            <TextBlock Grid.Row="59" Text=" " FontSize="8" Margin="0,0,0,72" /> 
        </Grid>
    </StackPanel>
</Page>
