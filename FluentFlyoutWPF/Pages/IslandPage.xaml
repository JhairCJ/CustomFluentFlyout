<Page x:Class="FluentFlyoutWPF.Pages.IslandPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
      xmlns:viewModels="clr-namespace:FluentFlyoutWPF.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="800"
      Title="IslandPage"
      d:DataContext="{d:DesignInstance viewModels:UserSettings}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      d:Background="White">

    <StackPanel MaxWidth="1000" Margin="16">
        <TextBlock Text="Fluent Island" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="Contenedor superior central para el contenido activo: muestra música, temporizador y el cajón de aplicaciones. Haz clic para abrir detalles y controles." FontSize="14" Opacity="0.75" Margin="0,0,0,20" MaxWidth="600" HorizontalAlignment="Left" TextWrapping="WrapWithOverflow" />
        <Grid x:Name="IslandSettingsGrid">
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Generales del contenedor" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ui:CardControl x:Name="IslandEnabledCard" Tag="Indexable" Grid.Row="1" Icon="{ui:SymbolIcon Album24}" Margin="0,0,0,3">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Habilitar Fluent Island" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="Muestra el contenedor arriba al centro para el contenido activo: música, temporizador y aplicaciones." FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding IslandEnabled, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl x:Name="IslandAnimatedCard" Tag="Indexable" Grid.Row="2" Icon="{ui:SymbolIcon Wand24}" Margin="0,0,0,24" IsEnabled="{Binding IslandEnabled}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Animaciones" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="Transiciones del Island (aparición y morph)." FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding IslandAnimated, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl x:Name="IslandModeCard" Tag="Indexable" Grid.Row="3" Icon="{ui:SymbolIcon Timer24}" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Visibilidad" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="Visible mientras haya actividad, o aviso temporal al evento." FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox SelectedIndex="{Binding IslandVisibilityMode, Mode=TwoWay}">
                    <ComboBoxItem Content="Visible mientras activo" />
                    <ComboBoxItem Content="Aviso temporal" />
                </ComboBox>
            </ui:CardControl>
            <ui:CardControl x:Name="IslandDurationCard" Tag="Indexable" Grid.Row="4" Icon="{ui:SymbolIcon Clock24}" Margin="0,0,0,24" IsEnabled="{Binding IslandEnabled}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Duración del aviso" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="Segundos que permanece visible al reproducir en aviso temporal." FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="1" Maximum="10" Value="{Binding IslandVisibilityDurationSeconds, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Width="150" IsMoveToPointEnabled="True" />
                    <ui:TextBlock Text="{Binding IslandVisibilityDurationText}" Width="24" TextAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Text="s" VerticalAlignment="Center" Margin="2,0,0,0" Opacity="0.6" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl x:Name="IslandReturnToInactiveCard" Tag="Indexable" Grid.Row="5" Icon="{ui:SymbolIcon EyeLines24}" Margin="0,0,0,24" IsEnabled="{Binding IslandEnabled}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Volver a inactivo" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="Al vencer el aviso o caer sin actividad, muestra la pieza inactiva (negra estrecha) en vez de ocultarse por completo." FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding IslandReturnToInactive, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl x:Name="IslandHideOnFullscreenCard" Tag="Indexable" Grid.Row="6" Icon="{ui:SymbolIcon Shield24}" Margin="0,0,0,24" IsEnabled="{Binding IslandEnabled}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Ocultar a pantalla completa" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="El Island se aparta con un juego o un vídeo a pantalla completa (también sin bordes), en una presentación o con el equipo bloqueado. El ajuste es del Island: no depende del de las notificaciones." FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="440" HorizontalAlignment="Left" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding IslandHideOnFullscreen, Mode=TwoWay}" />
            </ui:CardControl>
            <TextBlock Grid.Row="7" Text="Pantallas" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" />
            <!-- Pantallas del Island: cada una agrupa una o varias funcionalidades y la
                 rueda y las flechas recorren pantallas. El editor lo construye el
                 code-behind: una tarjeta por funcionalidad, EN ORDEN (ese orden es el de
                 presentación: de izquierda a derecha), con ◀ ▶ para colocarla y ✕ para
                 sacarla, más la lista de las que faltan. -->
            <ui:CardExpander x:Name="IslandScreensCard" Tag="Indexable" Grid.Row="8" Icon="{ui:SymbolIcon Grid24}" ContentPadding="0" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardExpander.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Pantallas del Island" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="Agrupa funcionalidades en pantallas: la rueda y las flechas las recorren en orden. Una pantalla con varias va de izquierda a derecha —sus fichas en el compacto y sus columnas en el expandido— con ancho y alto dinámicos, y el orden de las tarjetas es ese orden. Con una sola funcionalidad la pantalla se ve como siempre." FontSize="12" Opacity="0.5" TextWrapping="WrapWithOverflow" MaxWidth="440" HorizontalAlignment="Left" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="0,8,0,8">
                    <StackPanel x:Name="IslandScreensPanel" />
                    <Button Content="Nueva pantalla" Click="IslandScreenNew_Click" Padding="12,4" Margin="0,8,0,0" HorizontalAlignment="Left"
                            ToolTip="Nace con la primera funcionalidad que no esté en ninguna pantalla" />
                    <TextBlock Text="Una pantalla vacía no se guarda: cada pantalla necesita al menos una funcionalidad. Lo que cambies aquí se ve en el Island al momento si está a la vista." FontSize="12" Opacity="0.5" Margin="0,6,0,0" TextWrapping="WrapWithOverflow" MaxWidth="520" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:CardExpander>
            <TextBlock Grid.Row="9" Text="Música" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" />
            <ui:CardControl x:Name="IslandEqEnabledCard" Tag="Indexable" Grid.Row="10" Icon="{ui:SymbolIcon SoundWaveCircle24}" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Ecualizador" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="Barras con el audio real en la isla compacta y expandida." FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding IslandEqEnabled, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl x:Name="IslandEqBarsCard" Tag="Indexable" Grid.Row="11" Icon="{ui:SymbolIcon DataBarVertical24, Filled=True}" Margin="0,0,0,3" IsEnabled="{Binding IslandEqEnabled}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Número de barras" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="1" Maximum="10" Value="{Binding IslandEqBarCount, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Width="150" IsMoveToPointEnabled="True" />
                    <ui:TextBlock Text="{Binding IslandEqBarCount}" Width="24" TextAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl x:Name="IslandEqCenteredBarsCard" Tag="Indexable" Grid.Row="12" Icon="{ui:SymbolIcon AlignCenterHorizontal24, Filled=True}" Margin="0,0,0,3" IsEnabled="{Binding IslandEqEnabled}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Barras centradas" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="Refleja cada barra arriba y abajo del centro del ecualizador." FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding IslandEqCenteredBars, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl x:Name="IslandEqSensitivityCard" Tag="Indexable" Grid.Row="13" Icon="{ui:SymbolIcon BezierCurveSquare20}" Margin="0,0,0,3" IsEnabled="{Binding IslandEqEnabled}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Sensibilidad" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="1" Maximum="3" Value="{Binding IslandEqSensitivity, Mode=TwoWay}" TickFrequency="1" TickPlacement="Both" IsSnapToTickEnabled="True" Width="150" Margin="0,0,0,0" IsMoveToPointEnabled="True" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl x:Name="IslandEqSmoothingCard" Tag="Indexable" Grid.Row="14" Icon="{ui:SymbolIcon SlideTransition24}" Margin="0,0,0,3" IsEnabled="{Binding IslandEqEnabled}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Suavizado" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="0" Maximum="100" Value="{Binding IslandEqSmoothing, Mode=TwoWay}" TickFrequency="5" IsSnapToTickEnabled="True" Width="150" IsMoveToPointEnabled="True" />
                    <ui:TextBlock Text="{Binding IslandEqSmoothing}" Width="32" TextAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl x:Name="IslandStyleCard" Tag="Indexable" Grid.Row="15" Icon="{ui:SymbolIcon ExtendedDock24}" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Estilo" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="Notch: la isla sale del borde superior como la referencia." FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox SelectedIndex="{Binding IslandStyle, Mode=TwoWay}">
                    <ComboBoxItem Content="Isla flotante" />
                    <ComboBoxItem Content="Notch superior" />
                </ComboBox>
            </ui:CardControl>
            <ui:CardControl x:Name="IslandToleranceVerticalCard" Tag="Indexable" Grid.Row="16" Icon="{ui:SymbolIcon CursorHover24}" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Alcance vertical" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="Píxeles hacia abajo desde la línea. 0 = solo sobre la línea." FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="0" Maximum="40" Value="{Binding IslandHoverToleranceVertical, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Width="150" IsMoveToPointEnabled="True" />
                    <ui:TextBlock Text="{Binding IslandHoverToleranceVertical}" Width="32" TextAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl x:Name="IslandToleranceHorizontalCard" Tag="Indexable" Grid.Row="17" Icon="{ui:SymbolIcon CursorHover24}" Margin="0,0,0,24" IsEnabled="{Binding IslandEnabled}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Alcance horizontal" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="Píxeles a cada lado de la línea. 0 = ancho de la línea (120 px)." FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="0" Maximum="80" Value="{Binding IslandHoverToleranceHorizontal, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Width="150" IsMoveToPointEnabled="True" />
                    <ui:TextBlock Text="{Binding IslandHoverToleranceHorizontal}" Width="32" TextAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl x:Name="IslandShowPlayCard" Tag="Indexable" Grid.Row="18" Icon="{ui:SymbolIcon Play24}" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Mostrar al reproducir" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="Muestra el Island al iniciar o reanudar el medio durante el tiempo configurado." FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding IslandShowOnPlayPause, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl x:Name="IslandShowPauseCard" Tag="Indexable" Grid.Row="19" Icon="{ui:SymbolIcon Pause24}" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Mostrar al pausar" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="Muestra el Island al pausar el medio durante el tiempo configurado." FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding IslandShowOnPause, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl x:Name="IslandShowTrackChangeCard" Tag="Indexable" Grid.Row="20" Icon="{ui:SymbolIcon MusicNote2Play20}" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Mostrar al cambiar de canción" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="Muestra el Island cuando cambia la canción o sus metadatos." FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding IslandShowOnTrackChange, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl x:Name="IslandPauseCountsActiveCard" Tag="Indexable" Grid.Row="21" Icon="{ui:SymbolIcon Pause24}" Margin="0,0,0,3" IsEnabled="{Binding IslandEnabled}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Pausa de media cuenta como activo" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="En «Visible mientras activo», una sesión pausada sostiene la visibilidad con sus controles; desactívalo para que la pausa no cuente como actividad." FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding IslandPauseCountsActive, Mode=TwoWay}" />
            </ui:CardControl>
            <ui:CardControl x:Name="IslandExpandTriggerCard" Tag="Indexable" Grid.Row="22" Icon="{ui:SymbolIcon CursorHover24}" Margin="0,0,0,24" IsEnabled="{Binding IslandEnabled}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Expandir con rueda" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="La rueda hacia abajo sobre la isla compacta también expande; hacia arriba colapsa." FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox SelectedIndex="{Binding IslandExpandTrigger, Mode=TwoWay}">
                    <ComboBoxItem Content="Clic" />
                    <ComboBoxItem Content="Rueda" />
                    <ComboBoxItem Content="Ambos" />
                </ComboBox>
            </ui:CardControl>
            <ui:CardExpander x:Name="IslandTypographyCard" Tag="Indexable" Grid.Row="23" Icon="{ui:SymbolIcon TextCaseTitle24}" ContentPadding="0" Margin="0,0,0,24" IsEnabled="{Binding IslandEnabled}">
                <ui:CardExpander.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Tipografía y estilo de texto" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                        <TextBlock Text="Fuente y tamaños de los textos del Island. La fuente es compartida por los 3 textos." FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <ui:CardControl Background="Transparent" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultSolidBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="52,16,16,16">
                        <ui:CardControl.Header>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Tipografía" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                                <TextBlock Text="Las incluidas funcionan en cualquier PC. También puedes elegir una del sistema o escribir cualquier fuente instalada" FontSize="12" Opacity="0.5" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox x:Name="IslandFontFamilyComboBox" IsEditable="True" Text="{Binding IslandFontFamily, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" SelectionChanged="IslandFontFamilyComboBox_SelectionChanged" Width="220">
                            <ComboBoxItem Content="── Fuentes incluidas ──" IsEnabled="False" />
                            <ComboBoxItem Content="Inter" />
                            <ComboBoxItem Content="Manrope" />
                            <ComboBoxItem Content="Poppins" />
                            <ComboBoxItem Content="Montserrat" />
                            <ComboBoxItem Content="Nunito" />
                            <ComboBoxItem Content="Space Grotesk" />
                            <ComboBoxItem Content="Rubik" />
                            <ComboBoxItem Content="Quicksand" />
                            <ComboBoxItem Content="Comfortaa" />
                            <ComboBoxItem Content="Caveat" />
                            <ComboBoxItem Content="Baloo 2" />
                            <ComboBoxItem Content="Fredoka" />
                            <ComboBoxItem Content="Pacifico" />
                            <ComboBoxItem Content="Permanent Marker" />
                            <ComboBoxItem Content="Playfair Display" />
                            <ComboBoxItem Content="DM Serif Display" />
                            <ComboBoxItem Content="Lora" />
                            <ComboBoxItem Content="Zilla Slab" />
                            <ComboBoxItem Content="Fira Code" />
                            <ComboBoxItem Content="JetBrains Mono" />
                            <ComboBoxItem Content="Space Mono" />
                            <ComboBoxItem Content="── Fuentes del sistema ──" IsEnabled="False" />
                            <ComboBoxItem Content="Segoe UI Variable" />
                            <ComboBoxItem Content="Segoe UI" />
                            <ComboBoxItem Content="Bahnschrift" />
                            <ComboBoxItem Content="Calibri" />
                            <ComboBoxItem Content="Candara" />
                            <ComboBoxItem Content="Century Gothic" />
                            <ComboBoxItem Content="Constantia" />
                            <ComboBoxItem Content="Copperplate Gothic Bold" />
                            <ComboBoxItem Content="Corbel" />
                            <ComboBoxItem Content="Franklin Gothic Medium" />
                            <ComboBoxItem Content="Gabriola" />
                            <ComboBoxItem Content="Georgia" />
                            <ComboBoxItem Content="Palatino Linotype" />
                            <ComboBoxItem Content="Segoe Script" />
                            <ComboBoxItem Content="Trebuchet MS" />
                            <ComboBoxItem Content="Verdana" />
                            <ComboBoxItem Content="Cascadia Mono" />
                        </ComboBox>
                    </ui:CardControl>
                    <ui:CardControl Background="Transparent" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultSolidBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="52,16,16,16">
                        <ui:CardControl.Header>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Estilo de canción y autor" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                                <TextBlock Text="Grosor y presencia de los textos (los tamaños van por separado abajo)" FontSize="12" Opacity="0.5" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ComboBox SelectedIndex="{Binding IslandTextStyle, Mode=TwoWay}">
                            <ComboBoxItem Content="Moderno (recomendado)" />
                            <ComboBoxItem Content="Clásico" />
                            <ComboBoxItem Content="Audaz" />
                            <ComboBoxItem Content="Suave" />
                        </ComboBox>
                    </ui:CardControl>
                    <ui:CardControl Background="Transparent" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultSolidBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="52,16,16,16">
                        <ui:CardControl.Header>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Texto de canción en island compacto" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <Slider Minimum="10" Maximum="24" Value="{Binding IslandCompactTitleFontSize, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Width="150" IsMoveToPointEnabled="True" />
                            <ui:TextBlock Text="{Binding IslandCompactTitleFontSize}" Width="32" TextAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </ui:CardControl>
                    <ui:CardControl Background="Transparent" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultSolidBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="52,16,16,16">
                        <ui:CardControl.Header>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Texto de canción en island expandido" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <Slider Minimum="10" Maximum="24" Value="{Binding IslandExpandedTitleFontSize, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" Width="150" IsMoveToPointEnabled="True" />
