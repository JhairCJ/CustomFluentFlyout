<Window x:Class="FluentFlyoutWPF.Windows.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:island="clr-namespace:FluentFlyoutWPF.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:islandSettings="clr-namespace:FluentFlyout.Classes.Settings"
        xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        Width="640" Height="240" Top="-9999"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Topmost="True"
        Loaded="Window_Loaded" PreviewKeyDown="Island_KeyDown" UseLayoutRounding="True" SnapsToDevicePixels="True" Typography.NumeralAlignment="Tabular">
    <Window.Resources>
        <Style x:Key="IslandTimerInput" TargetType="TextBox">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="IslandForeground" Color="White"/>
        <sys:Double x:Key="IslandSecondaryOpacity">0.75</sys:Double>
        <sys:Double x:Key="IslandCaptionOpacity">0.75</sys:Double>
        <sys:Double x:Key="IslandEmphasisOpacity">0.85</sys:Double>
        <SolidColorBrush x:Key="IslandTileFill" Color="#D9252525"/>
        <SolidColorBrush x:Key="IslandTileHover" Color="#F23A3A3A"/>
        <SolidColorBrush x:Key="IslandTileBorder" Color="#66FFFFFF"/>
        <Style x:Key="IslandTile" TargetType="island:IslandActionSurface">
            <Setter Property="Background" Value="{DynamicResource IslandTileFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IslandTileBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource IslandTileHover}"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource IslandForeground}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IslandCompactTile" TargetType="island:IslandActionSurface" BasedOn="{StaticResource IslandTile}"><Setter Property="CornerRadius" Value="6"/></Style>
    </Window.Resources>
    <!-- Fluent Island de caja única: UNA sola Border cuyo tamaño interpola un muelle
         por frame (sin Storyboards, sin swaps de Visibility entre dos cajas: esa era
         la fuente del parpadeo). La ventana es de tamaño fijo para no re-maquetar a
         nivel OS; la ventana transparente fija mide 640 px y la zona muerta es click-through (Background null); solo la isla
         y la franja hover capturan el ratón. -->
    <Grid x:Name="Root" Background="{x:Null}">
        <!-- Línea gris opcional: la MANIJA del Island (si el Island está oculto, anuncia
             que hay algo que abrir). Su tamaño, su offset y su presencia los resuelve
             IslandLine/UpdateLine: solo se pinta cuando hay una puerta detrás. -->
        <Border x:Name="ActivityLine" CornerRadius="1.5"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="#66FFFFFF" Visibility="Collapsed"/>
        <Border x:Name="MediaStatusDot" Width="3" Height="3" CornerRadius="1.5"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Visibility="Collapsed" IsHitTestVisible="False"/>
        <!-- Franja de detección (001 MOD RF-10): la PUERTA del borde. Existe donde hay
             algo visible —la caja o su línea gris— o donde el usuario pida una puerta
             invisible (IslandHiddenAccess); su tamaño, su offset y su hit-test los pone
             UpdateLine (IslandWindow.Presentation.cs) desde la regla IslandLine. Por sí
             sola nunca despliega contenido: el clic es el que abre. -->
        <Border x:Name="HoverStrip" HorizontalAlignment="Center" VerticalAlignment="Top" Background="Transparent"
                MouseLeftButtonUp="InactiveZone_Click"/>

        <!-- La pieza inactiva (001 MOD RF-11, RF-16) NO es un elemento aparte: es
             la misma caja con ancho de reposo estrecho y sin contenido, así el paso
             compacto <-> inactivo es un morph de una sola superficie (nada de dos
             cajas cruzándose por Visibility). El hover solo la agranda y el clic
             abre la última usable. -->

        <!-- La caja: Width 240/200<->ancho configurado y Height 34<->expandido animados por código.
             ClipToBounds para que el contenido florezca desde dentro al crecer.
             Las flechas laterales cambian de funcionalidad (temporizador) y solo
             aparecen en expandido con su toggle y más de un modo disponible. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
            <controls:Button x:Name="ModePrevBtn" Width="28" Height="28" Margin="0,0,4,0" Padding="0"
                             VerticalAlignment="Center" Visibility="Collapsed" Focusable="True" Click="ModeArrow_Click"
                             Style="{StaticResource MicaWPF.Styles.TransparentButton}" ToolTip="{DynamicResource IslandTooltipPrevFeature}" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}">
                <ui:SymbolIcon Symbol="ChevronLeft24" Filled="True" Foreground="{DynamicResource IslandForeground}" FontSize="16"/>
            </controls:Button>
            <Border x:Name="IslandBox" Width="240" Height="34" CornerRadius="17"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="Black" BorderBrush="Transparent" BorderThickness="0"
                Visibility="Collapsed" ClipToBounds="True" RenderTransformOrigin="0.5,0.5"
                AllowDrop="True" DragOver="IslandBox_DragOver" DragLeave="IslandBox_DragLeave" Drop="IslandBox_Drop"
                MouseEnter="Box_MouseEnter" MouseLeave="Box_MouseLeave" PreviewMouseWheel="IslandBox_Wheel"
                MouseLeftButtonUp="HandleIslandClick">
            <Border.RenderTransform>
                <ScaleTransform x:Name="BoxScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Grid>
                <!-- The album art is used as a clipped viewport background, just like
                     the taskbar widget. The second layer keeps song changes smooth. -->
                <Canvas x:Name="BackgroundCanvas" IsHitTestVisible="False">
                    <Image x:Name="BackgroundImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                        <Image.Effect>
                            <BlurEffect x:Name="BackgroundImageBlurEffect" Radius="35" />
                        </Image.Effect>
                    </Image>
                    <Image x:Name="BackgroundImageNext" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                        <Image.Effect>
                            <BlurEffect x:Name="BackgroundImageNextBlurEffect" Radius="35" />
                        </Image.Effect>
                    </Image>
                </Canvas>

                <Border x:Name="ContentScrim" Background="#A6000000" IsHitTestVisible="False"/>

                <!-- Capa compacta: carátula izquierda + título + ecualizador -->
                <Grid x:Name="CompactLayer" Width="240" Height="34"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="CompactScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    <Grid x:Name="MusicCompactGrid" Margin="6,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <island:IslandActionSurface Activated="Album_Action" AutomationProperties.Name="{DynamicResource IslandTooltipChangeMedia}" x:Name="CompactArtWrap" Grid.Column="0" Width="22" Height="22" CornerRadius="12" ClipToBounds="True"
                                Background="#222" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Cursor="Hand" ToolTip="{DynamicResource IslandTooltipChangeMedia}" MouseLeftButtonUp="Album_Click"
                                MouseEnter="AlbumArt_MouseEnter" MouseLeave="AlbumArt_MouseLeave"
                                RenderTransformOrigin="0.5,0.5">
                            <island:IslandActionSurface.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CompactArtFlipScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="CompactArtTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </island:IslandActionSurface.RenderTransform>
                            <Grid>
                                <Image x:Name="CompactArt" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CompactNote" Text="♪" Foreground="{DynamicResource IslandForeground}" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <Border x:Name="CompactAlbumOverlay" CornerRadius="12" ClipToBounds="True" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False">
                                    <ui:SymbolIcon Symbol="ChevronRight20" Filled="True" Foreground="{DynamicResource IslandForeground}" FontSize="14"/>
                                </Border>
                            </Grid>
                        </island:IslandActionSurface>
                        <TextBlock x:Name="CompactTitle" Grid.Column="1" Foreground="{DynamicResource IslandForeground}" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis"
                                   Cursor="Hand" ToolTip="{DynamicResource IslandTooltipViewDetails}"
                                   MouseLeftButtonUp="CompactMiddle_Click"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CompactTitleScale2" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="CompactTitleTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <Grid Grid.Column="2" Width="36" Height="16" Background="Transparent"
                              Cursor="Hand" ToolTip="{DynamicResource IslandTooltipPlayPause}"
                              MouseLeftButtonUp="EqZone_Click">
                            <Image x:Name="CompactEq" Width="36" Height="16" Stretch="Uniform"
                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <TranslateTransform x:Name="CompactEqTranslate" X="0" Y="0"/>
                                </Image.RenderTransform>
                            </Image>
                            <controls:Button x:Name="EqPlayPauseBtn" Width="36" Height="16" Padding="0"
                                    Visibility="Collapsed" Focusable="True" Click="EqZone_Click"
                                    Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                                <ui:SymbolIcon x:Name="EqPlayPauseGlyph" Symbol="Pause16" Filled="True" Foreground="{DynamicResource IslandForeground}" FontSize="14"/>
                            </controls:Button>
                        </Grid>
                    </Grid>
                    <!-- Temporizador en compacto: icono izquierda + progreso centro + restante derecha -->
                    <Grid x:Name="TimerCompactGrid" Margin="6,0,10,0" Visibility="Collapsed"
                          Cursor="Hand" ToolTip="{DynamicResource IslandTooltipViewTimer}" MouseLeftButtonUp="TimerCompact_Click">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Timer20" Filled="True" Foreground="{DynamicResource IslandForeground}" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Grid x:Name="TimerProgressZone" Grid.Column="1" Margin="8,0,4,0" Height="14" VerticalAlignment="Center">
                            <Border x:Name="TimerProgressTrack" Height="5" CornerRadius="2.5" Background="#3F3F3F" VerticalAlignment="Center"/>
                            <Border x:Name="TimerProgressFill" Width="0" Height="5" CornerRadius="2.5" Background="#969696"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="TimerRemaining" Grid.Column="2" Text="00:00:00" Foreground="{DynamicResource IslandForeground}" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Cajón de aplicaciones en compacto: fila de iconos; cada clic lanza su aplicación.
                         Las que no caben en el renglón viven en el expandido y aquí solo se cuenta.
                         Celda pequeña a propósito (20x20 + 4 de separación = 24): así caben 6 en el
                         ancho del notch sin agrandar el Island. No agrandar sin recalcular el fit
                         del renglón en IslandWindow.Apps.cs. -->
                    <Grid x:Name="AppsCompactGrid" Margin="6,0,10,0" Visibility="Collapsed">
                        <ItemsControl x:Name="AppsCompactList" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <island:IslandActionSurface Activated="AppLaunch_Action" AutomationProperties.Name="{Binding Name}" Style="{StaticResource IslandCompactTile}" Width="20" Height="20" Margin="0,0,4,0" Cursor="Hand"
                                            ToolTip="{Binding ToolTip}" MouseLeftButtonUp="AppLaunch_Click">

                                        <Image Source="{Binding Icon}" Width="14" Height="14" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </island:IslandActionSurface>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="AppsCompactMore" Text="" Foreground="{DynamicResource IslandForeground}" FontSize="11" Opacity="{DynamicResource IslandSecondaryOpacity}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <!-- Estante de archivos en compacto: mosaicos de lo aparcado. Arrastra uno
                         fuera para sacarlo del estante; la celda es la misma que la del cajón
                         (20x20 + 4 de separación = 24 de paso) para que encajen los mismos. -->
                    <Grid x:Name="ShelfCompactGrid" Margin="6,0,10,0" Visibility="Collapsed">
                        <ItemsControl x:Name="ShelfCompactList" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <island:IslandActionSurface Activated="ShelfItem_Action" AutomationProperties.Name="{Binding Name}" Style="{StaticResource IslandCompactTile}" Width="20" Height="20" Margin="0,0,4,0" Cursor="Hand"
                                            ToolTip="{Binding ToolTip}"
                                            MouseLeftButtonDown="ShelfItem_MouseDown" MouseMove="ShelfItem_MouseMove">

                                        <ui:SymbolIcon Symbol="{Binding Glyph}" Filled="True" Foreground="{DynamicResource IslandForeground}" FontSize="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </island:IslandActionSurface>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ShelfCompactMore" Text="" Foreground="{DynamicResource IslandForeground}" FontSize="11" Opacity="{DynamicResource IslandSecondaryOpacity}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <!-- Recordatorios de calendario en compacto: glifo (campana cuando el evento
                         está dentro de su ventana de recordatorio), título del evento que viene y
                         su cuenta atrás. -->
                    <Grid x:Name="CalendarCompactGrid" Margin="6,0,10,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon x:Name="CalendarCompactGlyph" Grid.Column="0" Symbol="Calendar24" Filled="True"
                                       Foreground="{DynamicResource IslandForeground}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                                       IsHitTestVisible="False"/>
                        <TextBlock x:Name="CalendarCompactTitle" Grid.Column="1" Foreground="{DynamicResource IslandForeground}" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                        <TextBlock x:Name="CalendarCompactCountdown" Grid.Column="2" Foreground="{DynamicResource IslandForeground}" FontSize="11"
                                   Opacity="{DynamicResource IslandCaptionOpacity}" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <!-- Portapapeles en compacto: las últimas piezas copiadas. Cada celda es la
                         miniatura de la imagen o las primeras letras del texto; las que no caben
                         se cuentan con el «+N». El clic abre la lista expandida. -->
                    <Grid x:Name="ClipboardCompactGrid" Margin="6,0,10,0" Visibility="Collapsed"
                          Cursor="Hand" ToolTip="{DynamicResource IslandTooltipClipboardCompact}"
                          MouseLeftButtonUp="ClipboardCompact_Click">
                        <ItemsControl x:Name="ClipboardCompactList" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="20" Height="20" CornerRadius="6" Margin="0,0,4,0"
                                            Background="#22FFFFFF" ClipToBounds="True" ToolTip="{Binding Caption}">
                                        <Grid>
                                            <Image Source="{Binding Preview}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Initials}" Foreground="{DynamicResource IslandForeground}" FontSize="10"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ClipboardCompactMore" Text="" Foreground="{DynamicResource IslandForeground}" FontSize="11" Opacity="{DynamicResource IslandSecondaryOpacity}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <!-- Bluetooth en compacto: icono del tipo de dispositivo a la izquierda,
                         nombre al medio y batería a la derecha SOLO si el dispositivo la
                         informa: un aro de dos colores, verde lo que queda y gris claro el
                         resto (la geometría del arco la pinta IslandWindow.Bluetooth.cs).
                         Es SIEMPRE un aviso temporal: se retira al vencer su plazo. -->
                    <Grid x:Name="BluetoothCompactGrid" Margin="6,0,10,0" Visibility="Collapsed"
                          Cursor="Hand" ToolTip="{DynamicResource IslandTooltipBluetoothConnected}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon x:Name="BluetoothGlyph" Grid.Column="0" Symbol="Bluetooth24" Filled="True"
                                       Foreground="{DynamicResource IslandForeground}" FontSize="15" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="BluetoothName" Grid.Column="1" Foreground="{DynamicResource IslandForeground}" FontSize="12"
                                   TextAlignment="Right"
                                   Margin="8,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False"/>
                        <Grid Grid.Column="2" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Grid x:Name="BluetoothBatteryZone" Width="18" Height="18" Visibility="Collapsed">
                                <!-- Fondo del aro (lo que queda por delante) y el arco verde encima. El
                                     Path mide 18x18 con Stretch=None para que las coordenadas absolutas
                                     de BuildBatteryArc caigan exactamente en esta zona. -->
                                <Ellipse Width="16" Height="16" Stroke="#59FFFFFF" StrokeThickness="2"/>
                                <Path x:Name="BluetoothBatteryArc" Width="18" Height="18" Stretch="None"
                                      HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Stroke="#6CCB5F" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                            <!-- Porcentaje en números: verde al conectar cargando, rojo al
                                 desconectarse (el color y el glifo del rayo los pone el código). -->
                            <TextBlock x:Name="BluetoothPercent" Foreground="#6CCB5F" FontSize="12"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                    <!-- Dictado por voz en compacto (spec 006): micrófono a la IZQUIERDA y
                         visualizador de ondas a la DERECHA con el nivel real del micrófono.
                         El centro solo escribe estado (transcribiendo o el motivo del fallo):
                         mientras se habla no hay texto que leer, solo que ver. -->
                    <Grid x:Name="DictationCompactGrid" Margin="6,0,10,0" Visibility="Collapsed"
                          ToolTip="{DynamicResource IslandTooltipDictation}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon x:Name="DictationGlyph" Grid.Column="0" Symbol="Mic24"
                                       Filled="False" Foreground="{DynamicResource IslandForeground}" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        <TextBlock x:Name="DictationStatus" Grid.Column="1" Text="" FontSize="12"
                                   Margin="8,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False">
                            <TextBlock.Foreground>
                                <LinearGradientBrush x:Name="DictationStatusShimmerBrush" StartPoint="-0.2,0.5" EndPoint="0.2,0.5">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform x:Name="DictationStatusShimmerOffset"/>
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="#BFFFFFFF" Offset="0"/>
                                    <GradientStop Color="#BFFFFFFF" Offset="0.25"/>
                                    <GradientStop Color="White" Offset="0.5"/>
                                    <GradientStop Color="#BFFFFFFF" Offset="0.75"/>
                                    <GradientStop Color="#BFFFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <!-- Las barras las crea el código (IslandWindow.Dictation.cs): su número y su
                             alto siguen al nivel del micrófono, no a un valor fijo del XAML. -->
                        <StackPanel x:Name="DictationWave" Grid.Column="2" Orientation="Horizontal"
                                    Height="22" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>

                <!-- Capa expandida: tarjeta compacta con carátula + título/artista + tiempos + controles.
                     Siempre Visible (medible) y gobernada por opacidad; el hit-test lo
                     decide el código según el progreso del morph. -->
                <StackPanel x:Name="ExpandedLayer" Margin="14,12,14,12" Opacity="0">
                    <ScrollViewer x:Name="ExpandedViewport" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ExpandedContents" VerticalAlignment="Top">
                    <StackPanel x:Name="ActionFeedback" Visibility="Collapsed">
                    <TextBlock x:Name="ActionStatus" Foreground="#FFFFB4AB" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <StackPanel Orientation="Horizontal"><Button x:Name="ActionRetry" Content="{DynamicResource IslandRetry}" Click="ActionRetry_Click" Margin="0,4,8,4"/>
                    <Button x:Name="ActionSettings" Content="{DynamicResource IslandReviewSettings}" Click="ActionSettings_Click" Margin="0,4,0,4"/></StackPanel>
                    </StackPanel>
                    <Grid x:Name="MusicExpandedTop">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <island:IslandActionSurface Activated="Album_Action" AutomationProperties.Name="{DynamicResource IslandTooltipChangeMedia}" x:Name="ExpandedArtWrap" Grid.Column="0" Width="48" Height="48" CornerRadius="12" ClipToBounds="True" Background="#222"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Cursor="Hand" ToolTip="{DynamicResource IslandTooltipChangeMedia}" MouseLeftButtonUp="Album_Click"
                                 MouseEnter="AlbumArt_MouseEnter" MouseLeave="AlbumArt_MouseLeave"
                                 RenderTransformOrigin="0.5,0.5">
                            <island:IslandActionSurface.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ExpandedArtFlipScale" ScaleX="1" ScaleY="1"/>
                                    <ScaleTransform x:Name="ExpandedArtScale" ScaleX="1" ScaleY="1"/>
                                </TransformGroup>
                            </island:IslandActionSurface.RenderTransform>
                            <Grid>
                                <Image x:Name="ExpandedArt" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ExpandedNote" Text="♪" Foreground="{DynamicResource IslandForeground}" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <Border x:Name="ExpandedAlbumOverlay" CornerRadius="12" ClipToBounds="True" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False">
                                    <ui:SymbolIcon Symbol="ChevronRight20" Filled="True" Foreground="{DynamicResource IslandForeground}" FontSize="18"/>
                                </Border>
                            </Grid>
                        </island:IslandActionSurface>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SongTitle" Text="{DynamicResource IslandUnknownTitle}" Foreground="{DynamicResource IslandForeground}"
                                       FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       RenderTransformOrigin="0,0.5">
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="SongTitleScale" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="SongTitleTranslate" X="0" Y="0"/>
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="SongArtist" Text="{DynamicResource IslandUnknownArtist}" Foreground="{DynamicResource IslandForeground}"
                                       FontSize="10" Opacity="{DynamicResource IslandSecondaryOpacity}" TextTrimming="CharacterEllipsis"
                                       RenderTransformOrigin="0,0.5">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="SongArtistTranslate" X="0" Y="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                        <Image x:Name="ExpandedEq" Grid.Column="2" Width="36" Height="16" Stretch="Uniform"
                               VerticalAlignment="Center" Margin="6,0,2,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <Grid x:Name="SeekRow" Margin="0,8,0,0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="SeekTranslate" X="0" Y="0"/>
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PosText" Grid.Column="0" Text="0:00" Foreground="{DynamicResource IslandForeground}" FontSize="11" Opacity="{DynamicResource IslandSecondaryOpacity}" VerticalAlignment="Center"/>
                        <Grid x:Name="TimelineHost" Grid.Column="1" Margin="8,0,8,0" Height="14"
                              VerticalAlignment="Center" SizeChanged="TimelineHost_SizeChanged">
                            <Border x:Name="TimelineTrack" Height="5" CornerRadius="2.5" Background="#3F3F3F"
                                    VerticalAlignment="Center"/>
                            <Border x:Name="TimelineProgress" Width="0" Height="5" CornerRadius="2.5" Background="#969696"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <!-- Transparent hit target over the custom track. The reference design
                                 has no permanent thumb, so the native thumb is effectively hidden. -->
                            <Slider x:Name="Seekbar" Minimum="0" Maximum="100" Value="0" Opacity="0.01"
                                    AutomationProperties.Name="{DynamicResource ShowSeekbarTitle}"
                                    VerticalAlignment="Stretch"
                                    PreviewMouseLeftButtonDown="Seekbar_Down" PreviewMouseLeftButtonUp="Seekbar_Up"
                                    PreviewMouseMove="Seekbar_Move" LostMouseCapture="Seekbar_LostCapture"
                                    ValueChanged="Seekbar_ValueChanged"/>
                        </Grid>
                        <TextBlock x:Name="DurText" Grid.Column="2" Text="0:00" Foreground="{DynamicResource IslandForeground}" FontSize="11" Opacity="{DynamicResource IslandSecondaryOpacity}" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel x:Name="ControlsRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="ControlsTranslate" X="0" Y="0"/>
                        </StackPanel.RenderTransform>
                        <controls:Button x:Name="BtnPrev" Height="32" Width="32" Margin="4,0" Padding="0"
                                         Click="Prev_Click" Focusable="True"
                                         Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                            <ui:SymbolIcon Symbol="Previous20" Filled="True" Foreground="{DynamicResource IslandForeground}" FontSize="22"/>
                        </controls:Button>
                        <controls:Button x:Name="BtnPlay" Height="36" Width="36" Margin="4,0" Padding="0"
                                         Click="PlayPause_Click" Focusable="True"
                                         Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                            <ui:SymbolIcon x:Name="PlayGlyph" Symbol="Pause16" Filled="True" Foreground="{DynamicResource IslandForeground}" FontSize="20"/>
                        </controls:Button>
                        <controls:Button x:Name="BtnNext" Height="32" Width="32" Margin="4,0" Padding="0"
                                          Click="Next_Click" Focusable="True"
                                          Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                            <ui:SymbolIcon Symbol="Next20" Filled="True" Foreground="{DynamicResource IslandForeground}" FontSize="22"/>
                        </controls:Button>
                    </StackPanel>
                    <!-- Temporizador en expandido: tiempo libre + controles a la izquierda, presets a la derecha -->
                    <StackPanel x:Name="TimerExpanded" Visibility="Collapsed">
                        <Grid x:Name="TimerConfigGrid" SizeChanged="TimerConfig_SizeChanged">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="0"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="TimerEntryPanel" Grid.Column="0" VerticalAlignment="Center">
                                <!-- Reels infinitos H:M:S: arrastrar o rueda (arriba reduce, abajo aumenta).
                                     Sin teclado: la ventana es NoActivate y jamás tiene foco. -->
                                <Grid x:Name="TimerReels" HorizontalAlignment="Left" Cursor="SizeNS"
                                      ToolTip="{DynamicResource IslandTooltipTimerReels}" PreviewMouseWheel="Reel_Wheel">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource IslandTimerHoursShort}" Foreground="{DynamicResource IslandForeground}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{DynamicResource IslandTimerMinutesShort}" Foreground="{DynamicResource IslandForeground}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{DynamicResource IslandTimerSecondsShort}" Foreground="{DynamicResource IslandForeground}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBox Grid.Row="1" x:Name="ReelH" Tag="H" Grid.Column="0" Text="00" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{DynamicResource IslandForeground}" Style="{StaticResource IslandTimerInput}" MinWidth="44" Height="36" Padding="0,0" Background="Transparent" BorderThickness="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" MaxLength="2" Focusable="False" AutomationProperties.Name="{DynamicResource IslandTimerHours}" TextChanged="TimerEntry_TextChanged" LostKeyboardFocus="TimerEntry_LostFocus" PreviewKeyDown="TimerEntry_KeyDown" LostMouseCapture="Reel_LostCapture" TextAlignment="Center"
                                               PreviewMouseLeftButtonDown="Reel_Down" PreviewMouseMove="Reel_Move" PreviewMouseLeftButtonUp="Reel_Up"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text=":" FontSize="24" Foreground="{DynamicResource IslandForeground}" Opacity="{DynamicResource IslandSecondaryOpacity}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" x:Name="ReelM" Tag="M" Grid.Column="2" Text="00" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{DynamicResource IslandForeground}" Style="{StaticResource IslandTimerInput}" MinWidth="44" Height="36" Padding="0,0" Background="Transparent" BorderThickness="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" MaxLength="2" Focusable="False" AutomationProperties.Name="{DynamicResource IslandTimerMinutes}" TextChanged="TimerEntry_TextChanged" LostKeyboardFocus="TimerEntry_LostFocus" PreviewKeyDown="TimerEntry_KeyDown" LostMouseCapture="Reel_LostCapture" TextAlignment="Center"
                                               PreviewMouseLeftButtonDown="Reel_Down" PreviewMouseMove="Reel_Move" PreviewMouseLeftButtonUp="Reel_Up"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text=":" FontSize="24" Foreground="{DynamicResource IslandForeground}" Opacity="{DynamicResource IslandSecondaryOpacity}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" x:Name="ReelS" Tag="S" Grid.Column="4" Text="00" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{DynamicResource IslandForeground}" Style="{StaticResource IslandTimerInput}" MinWidth="44" Height="36" Padding="0,0" Background="Transparent" BorderThickness="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" MaxLength="2" Focusable="False" AutomationProperties.Name="{DynamicResource IslandTimerSeconds}" TextChanged="TimerEntry_TextChanged" LostKeyboardFocus="TimerEntry_LostFocus" PreviewKeyDown="TimerEntry_KeyDown" LostMouseCapture="Reel_LostCapture" TextAlignment="Center"
                                               PreviewMouseLeftButtonDown="Reel_Down" PreviewMouseMove="Reel_Move" PreviewMouseLeftButtonUp="Reel_Up"/>
                                </Grid>
                                <TextBlock x:Name="TimerStatus" FontSize="10" TextTrimming="CharacterEllipsis" Opacity="{DynamicResource IslandSecondaryOpacity}" Foreground="{DynamicResource IslandForeground}" Text="" Margin="0,2,0,0">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <controls:Button x:Name="TimerStartBtn" Content="{DynamicResource IslandTimerStart}" Height="24" Margin="0,0,4,0" Padding="10,0"
                                                     Foreground="{DynamicResource IslandForeground}" Focusable="True" Click="TimerStart_Click"
                                                     Style="{StaticResource MicaWPF.Styles.TransparentButton}"/>
                                    <controls:Button x:Name="TimerRestartBtn" Content="{DynamicResource IslandTimerRestart}" Height="24" Padding="10,0"
                                                     Foreground="{DynamicResource IslandForeground}" Focusable="True" Click="TimerRestart_Click" Visibility="Collapsed"
                                                     Style="{StaticResource MicaWPF.Styles.TransparentButton}"/>
                                </StackPanel>
                            </StackPanel>
                            <ComboBox x:Name="TimerPresetPicker" Grid.Row="1" Grid.Column="0" Height="24" Margin="0,2,0,0"
                                      ItemsSource="{Binding ItemsSource, ElementName=TimerPresetList}"
                                      SelectedItem="{Binding SelectedItem, ElementName=TimerPresetList, Mode=TwoWay}"
                                      DisplayMemberPath="Name" AutomationProperties.Name="{DynamicResource IslandTimerOrigin}"/>
                            <ListBox x:Name="TimerPresetList" Grid.Row="1" Grid.Column="0" MaxHeight="112" Margin="0,8,0,0"
                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource IslandForeground}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="TimerPresetList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,1,0,3">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource IslandForeground}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="118"/>
                                            <TextBlock Text="{Binding DurationText}" FontSize="11" Opacity="{DynamicResource IslandSecondaryOpacity}" Foreground="{DynamicResource IslandForeground}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </StackPanel>
                    <!-- Corriendo/pausado: iconos a la izquierda; origen + restante a la derecha -->
                    <Grid x:Name="TimerRunPanel" Visibility="Collapsed" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <controls:Button x:Name="TimerRunPauseBtn" Height="36" Width="36" Padding="0"
                                         Focusable="True" Click="TimerPause_Click" ToolTip="{DynamicResource IslandTooltipPauseResume}" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                         Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                            <ui:SymbolIcon x:Name="TimerRunPauseGlyph" Symbol="Pause24" Filled="True" Foreground="{DynamicResource IslandForeground}" FontSize="20"/>
                        </controls:Button>
                        <controls:Button x:Name="TimerRunCancelBtn" Height="36" Width="36" Padding="0"
                                         Focusable="True" Click="TimerCancel_Click" ToolTip="{DynamicResource IslandTooltipCancel}" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                         Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                            <ui:SymbolIcon Symbol="Dismiss24" Filled="True" Foreground="{DynamicResource IslandForeground}" FontSize="20"/>
                        </controls:Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock x:Name="TimerRunOrigin" FontSize="11" Opacity="{DynamicResource IslandSecondaryOpacity}" Foreground="{DynamicResource IslandForeground}" Text="{DynamicResource IslandTimerOrigin}" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TimerRunRemaining" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource IslandForeground}" Text="00:00:00" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                    <!-- Aviso al llegar a cero: reiniciar + X a la izquierda, origen a la derecha -->
                    <Grid x:Name="TimerAlert" Visibility="Collapsed" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <controls:Button x:Name="TimerAlertRestartBtn" Height="36" Width="36" Padding="0"
                                         Focusable="True" Click="TimerAlertRestart_Click" ToolTip="{DynamicResource IslandTimerRestart}" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                         Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" Filled="True" Foreground="{DynamicResource IslandForeground}" FontSize="20"/>
                        </controls:Button>
                        <controls:Button x:Name="TimerAlertDismissBtn" Height="36" Width="36" Padding="0"
                                         Focusable="True" Click="TimerAlertDismiss_Click" ToolTip="{DynamicResource IslandTooltipFinish}" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}"
                                         Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                            <ui:SymbolIcon Symbol="Dismiss24" Filled="True" Foreground="{DynamicResource IslandForeground}" FontSize="20"/>
                        </controls:Button>
                        </StackPanel>
                        <TextBlock x:Name="TimerAlertName" Grid.Column="1" Text="{DynamicResource IslandTimerOrigin}" Foreground="{DynamicResource IslandForeground}" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <!-- Cajón de aplicaciones en expandido: cuadrícula de iconos con nombre.
                         La altura la mide el contenedor (SyncMeasuredHeight) y el ancho es el configurado. -->
                    <StackPanel x:Name="AppsExpanded" Visibility="Collapsed">
                        <!-- Sin título: el cajón se reconoce por sus iconos y el rótulo era
                             altura de sobra (petición de compacto). -->
                        <ItemsControl x:Name="AppsExpandedList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <island:IslandActionSurface Width="44" Height="44" Margin="2" Style="{StaticResource IslandTile}" AutomationProperties.Name="{Binding Name}" Activated="AppLaunch_Action"
                                            ToolTip="{Binding ToolTip}" MouseLeftButtonUp="AppLaunch_Click">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Image Grid.Row="0" Source="{Binding Icon}" Width="24" Height="24" Margin="0,2,0,0"
                                                   VerticalAlignment="Top" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="{DynamicResource IslandForeground}" FontSize="9" Opacity="{DynamicResource IslandCaptionOpacity}"
                                                       Margin="3,0,3,2" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                        </Grid>
                                    </island:IslandActionSurface>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- Estante de archivos en expandido: mosaicos con su tipo y una cruz para
                         quitarlos (quitarlos devuelve el archivo a su carpeta original; nunca
                         se borra). La altura la mide el contenedor (SyncMeasuredHeight). -->
                    <StackPanel x:Name="ShelfExpanded" Visibility="Collapsed">
                        <TextBlock Text="{Binding IslandShelfStatus}" Foreground="{DynamicResource IslandForeground}" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding IslandShelfError}" Foreground="#FFFFB4AB" FontSize="11" TextWrapping="Wrap"/>
                        <Button Content="{DynamicResource IslandShelfCancelOperation}" Click="ShelfCancelOperation_Click" HorizontalAlignment="Left">
                            <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IslandShelfCanCancel}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <!-- Sin título: el estante se reconoce por sus mosaicos y el rótulo era
                             altura de sobra (petición de compacto). -->
                        <TextBlock x:Name="ShelfExpandedEmpty" Text="{DynamicResource IslandShelfEmpty}"
                                   FontSize="12" Opacity="0.55" Foreground="{DynamicResource IslandForeground}" Margin="0,0,0,6"
                                   TextWrapping="WrapWithOverflow" Visibility="Collapsed"/>
                        <ItemsControl x:Name="ShelfExpandedList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <island:IslandActionSurface Width="44" Height="44" Margin="2" Style="{StaticResource IslandTile}" AutomationProperties.Name="{Binding Name}" Activated="ShelfItem_Action"
                                            ToolTip="{Binding ToolTip}"
                                            MouseLeftButtonDown="ShelfItem_MouseDown" MouseMove="ShelfItem_MouseMove">

                                        <Grid>
                                            <!-- El mosaico enseña el NOMBRE del archivo o de la carpeta, no su
                                                 tipo: el glifo ya dice si es carpeta o documento, y «CARPETA»
                                                 no le dice al usuario cuál de sus carpetas es. -->
                                            <StackPanel VerticalAlignment="Center" Margin="2,0">
                                                <ui:SymbolIcon Symbol="{Binding Glyph}" Filled="True" Foreground="{DynamicResource IslandForeground}"
                                                               FontSize="16" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource IslandForeground}" FontSize="9" Opacity="{DynamicResource IslandEmphasisOpacity}"
                                                           TextAlignment="Center" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Width="14" Height="14" CornerRadius="7" Background="#55000000"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                                    Cursor="Hand" ToolTip="{DynamicResource IslandShelfRemove}"
                                                    MouseLeftButtonUp="ShelfItemRemove_Click">
                                                <ui:SymbolIcon Symbol="Dismiss24" Filled="True" Foreground="{DynamicResource IslandForeground}" FontSize="10"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </island:IslandActionSurface>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- Portapapeles en expandido: todas las piezas. Al hacer clic en una se
                         copia al portapapeles y el usuario la pega con Ctrl+V; el aviso de
                         «copiado» se borra solo. La altura la mide el contenedor. -->
                    <StackPanel x:Name="ClipboardExpanded" Visibility="Collapsed" Margin="0,2,0,2">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{DynamicResource IslandClipboardHeader}" FontSize="11" Opacity="{DynamicResource IslandSecondaryOpacity}"
                                       Foreground="{DynamicResource IslandForeground}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ClipboardStatus" Text="" FontSize="10" Opacity="{DynamicResource IslandEmphasisOpacity}"
                                       Foreground="#B6F0B5" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="ClipboardExpandedEmpty" Text="{DynamicResource IslandClipboardEmpty}"
                                   FontSize="12" Opacity="0.55" Foreground="{DynamicResource IslandForeground}" Margin="0,0,0,6"
                                   TextWrapping="WrapWithOverflow" Visibility="Collapsed"/>
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ClipboardExpandedList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6" Cursor="Hand" ToolTip="{Binding Caption}"
                                              MouseLeftButtonUp="ClipboardItem_Click">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                                    Background="#22FFFFFF" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding Preview}" Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock Text="{Binding Initials}" Foreground="{DynamicResource IslandForeground}" FontSize="11"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Caption}" Foreground="{DynamicResource IslandForeground}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="8,0,8,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <ui:SymbolIcon Grid.Column="2" Symbol="Copy24" Filled="True" Foreground="{DynamicResource IslandForeground}"
                                                           FontSize="14" Opacity="0.6" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                    <!-- Recordatorios de calendario en expandido: el evento que va a empezar (o los
                         próximos) con su franja y su cuenta atrás. La altura la mide el contenedor
                         (SyncMeasuredHeight). -->
                    <StackPanel x:Name="CalendarExpanded" Visibility="Collapsed" Margin="0,2,0,2">
                        <Grid Margin="0,0,0,6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock x:Name="CalendarExpandedHeader" Text="{DynamicResource IslandCalendarHeaderUpcoming}" FontSize="11" Opacity="{DynamicResource IslandSecondaryOpacity}"
                                       Foreground="{DynamicResource IslandForeground}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Margin="0,2,0,0" TextWrapping="Wrap" x:Name="CalendarSyncedText" Text="" FontSize="10" Opacity="{DynamicResource IslandSecondaryOpacity}"
                                       Foreground="{DynamicResource IslandForeground}" HorizontalAlignment="Left"/>
                        </Grid>
                        <TextBlock x:Name="CalendarExpandedEmpty" Text="{DynamicResource IslandCalendarEmpty}"
                                   FontSize="12" Opacity="0.55" Foreground="{DynamicResource IslandForeground}" Margin="0,0,0,6"
                                   TextWrapping="WrapWithOverflow" Visibility="Collapsed"/>
                        <ItemsControl x:Name="CalendarExpandedList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6" ToolTip="{Binding ToolTipText}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding WhenText}" FontSize="11" Opacity="{DynamicResource IslandCaptionOpacity}"
                                                   Foreground="{DynamicResource IslandForeground}" VerticalAlignment="Center" Width="78"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource IslandForeground}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0,6,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CountdownText}" FontSize="11" Opacity="{DynamicResource IslandSecondaryOpacity}"
                                                   Foreground="{DynamicResource IslandForeground}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- Cargador en compacto: rayo a la izquierda (verde al enchufar, rojo al
                         desenchufar) con el título y el porcentaje de batería a la derecha.
                         Es SIEMPRE un aviso temporal: se retira al vencer su plazo. -->
                    <Grid x:Name="PowerCompactGrid" Margin="6,0,10,0" Visibility="Collapsed"
                          Cursor="Hand" ToolTip="{DynamicResource IslandTooltipPower}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon x:Name="PowerGlyph" Grid.Column="0" Symbol="BatteryCharge24" Filled="True"
                                       Foreground="#6CCB5F" FontSize="15" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="PowerTitle" Grid.Column="1" Text="{DynamicResource IslandPowerCharging}" Foreground="{DynamicResource IslandForeground}" FontSize="12"
                                   Margin="8,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False"/>
                        <TextBlock x:Name="PowerPercent" Grid.Column="2" Text="" Foreground="#6CCB5F"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                    <!-- Clima en compacto: glifo del cielo a la izquierda y temperatura a la
                         derecha. Es contenido pasivo (no «está pasando»): se ve al navegar
                         hasta su pantalla y vive lo que viva su vista. -->
                    <Grid x:Name="WeatherCompactGrid" Margin="6,0,10,0" Visibility="Collapsed"
                          Cursor="Hand" ToolTip="{DynamicResource IslandTooltipWeather}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon x:Name="WeatherCompactGlyph" Grid.Column="0" Symbol="WeatherCloudy24"
                                       Filled="True" Foreground="{DynamicResource IslandForeground}" FontSize="15"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="WeatherCompactTemp" Grid.Column="2" Text="—°" Foreground="{DynamicResource IslandForeground}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="8,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <!-- Clima en expandido: lugar, cielo, temperatura y extremos del día. -->
                    <StackPanel x:Name="WeatherExpanded" Visibility="Collapsed" Margin="0,2,0,2">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="WeatherPlace" Foreground="{DynamicResource IslandForeground}" FontSize="12" Opacity="{DynamicResource IslandCaptionOpacity}"
                                       HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"/>
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" x:Name="WeatherUpdated" Foreground="{DynamicResource IslandForeground}" FontSize="10" Opacity="{DynamicResource IslandSecondaryOpacity}"
                                       HorizontalAlignment="Right" IsHitTestVisible="False"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="WeatherExpandedGlyph" Grid.Column="0" Symbol="WeatherCloudy24"
                                           Filled="True" Foreground="{DynamicResource IslandForeground}" FontSize="34"
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="WeatherExpandedTemp" Text="—°" Foreground="{DynamicResource IslandForeground}"
                                           FontSize="26" FontWeight="SemiBold" IsHitTestVisible="False"/>
                                <TextBlock x:Name="WeatherCondition" Text="" Foreground="{DynamicResource IslandForeground}" FontSize="12"
                                           Opacity="{DynamicResource IslandSecondaryOpacity}" IsHitTestVisible="False"/>
                                <TextBlock x:Name="WeatherRange" Text="" Foreground="{DynamicResource IslandForeground}" FontSize="11"
                                           Opacity="{DynamicResource IslandSecondaryOpacity}" Margin="0,2,0,0" IsHitTestVisible="False"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <!-- PANTALLA COMBINADA en expandido: las funcionalidades que la componen van
                         de izquierda a derecha, una columna por funcionalidad (change
                         island-pantallas RF-2/RF-3). Los paneles de cada una se MUEVEN aquí
                         mientras la pantalla combinada está delante y vuelven a su sitio al
                         salir (IslandWindow.Screens.cs); las columnas que no componen la
                         pantalla se ocultan y el ancho de la caja es dinámico (el ancho lo
                         fija el número de columnas). -->
                    <Border x:Name="ScreenViewport" Visibility="Collapsed">
                    <StackPanel x:Name="ScreenExpandedRow" Orientation="Horizontal" Visibility="Collapsed">
                        <StackPanel x:Name="ScreenColumnMedia" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed"/>
                        <StackPanel x:Name="ScreenColumnTimer" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed"/>
                        <StackPanel x:Name="ScreenColumnApps" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed"/>
                        <StackPanel x:Name="ScreenColumnShelf" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed"/>
                        <StackPanel x:Name="ScreenColumnCalendar" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed"/>
                        <StackPanel x:Name="ScreenColumnClipboard" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed"/>
                        <StackPanel x:Name="ScreenColumnWeather" VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed"/>
                    </StackPanel>
                    </Border>
                    </StackPanel>
                    </ScrollViewer>
                </StackPanel>
                <Canvas IsHitTestVisible="False">
                    <Path x:Name="IslandOutline" StrokeThickness="2" Stretch="None"/>
                </Canvas>
            </Grid>
        </Border>
            <controls:Button x:Name="ModeNextBtn" Width="28" Height="28" Margin="4,0,0,0" Padding="0"
                             VerticalAlignment="Center" Visibility="Collapsed" Focusable="True" Click="ModeArrow_Click"
                             Style="{StaticResource MicaWPF.Styles.TransparentButton}" ToolTip="{DynamicResource IslandTooltipNextFeature}" AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}">
                <ui:SymbolIcon Symbol="ChevronRight24" Filled="True" Foreground="{DynamicResource IslandForeground}" FontSize="16"/>
            </controls:Button>
        </StackPanel>
    </Grid>
</Window>
