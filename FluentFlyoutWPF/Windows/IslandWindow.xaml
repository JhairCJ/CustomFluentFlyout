<Window x:Class="FluentFlyoutWPF.Windows.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        Width="480" SizeToContent="Height" Top="-9999"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Topmost="True"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave" Loaded="Window_Loaded">
    <!-- Isla negra estilo referencia: compacta 240x34 / expandida 480. Fondo Transparent para cazar hover aun oculta. -->
    <Grid Background="Transparent">
        <!-- Línea gris opcional: indica que el Island está activo -->
        <Border x:Name="ActivityLine" Height="2" Width="120" CornerRadius="1"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0"
                Background="#66FFFFFF" Visibility="Collapsed"/>
        <!-- Franja hover invisible: altura ajustable con tolerancia -->
        <Border x:Name="HoverStrip" Height="12" VerticalAlignment="Top" Background="Transparent"/>

        <!-- Compacto: carátula izquierda + indicador derecha -->
        <Border x:Name="CompactBorder" Width="240" Height="34" CornerRadius="17"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="Black" BorderBrush="#33FFFFFF" BorderThickness="1"
                Visibility="Collapsed">
            <Grid Margin="6,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6" ClipToBounds="True"
                        Background="#222" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Image x:Name="CompactArt" Stretch="UniformToFill"/>
                        <TextBlock x:Name="CompactNote" Text="♪" Foreground="White" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="CompactTitle" Grid.Column="1" Foreground="White" FontSize="12"
                           VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis"/>
                <Image x:Name="CompactEq" Grid.Column="2" Width="36" Height="16" Stretch="Uniform"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </Border>

        <!-- Expandido: carátula + título/artista + tiempos + controles -->
        <Border x:Name="ExpandedBorder" Width="480" CornerRadius="18"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="Black" BorderBrush="#33FFFFFF" BorderThickness="1"
                Visibility="Collapsed" Padding="16,12,16,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="12" ClipToBounds="True" Background="#222">
                        <Grid>
                            <Image x:Name="ExpandedArt" Stretch="UniformToFill"/>
                            <TextBlock x:Name="ExpandedNote" Text="♪" Foreground="White" FontSize="28"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,2,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="SongTitle" Text="Título desconocido" Foreground="White"
                                   FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SongArtist" Text="Artista desconocido" Foreground="White"
                                   FontSize="14" Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Image x:Name="ExpandedEq" Grid.Column="2" Width="56" Height="24" Stretch="Uniform"
                           VerticalAlignment="Center" Margin="8,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PosText" Grid.Column="0" Text="0:00" Foreground="White" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                    <Slider x:Name="Seekbar" Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center"
                            Minimum="0" Maximum="100" Value="0"
                            PreviewMouseLeftButtonDown="Seekbar_Down" PreviewMouseLeftButtonUp="Seekbar_Up"/>
                    <TextBlock x:Name="DurText" Grid.Column="2" Text="0:00" Foreground="White" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <controls:Button x:Name="BtnPrev" Height="36" Width="44" Margin="12,0"
                                     Click="Prev_Click" Focusable="False"
                                     Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                        <ui:SymbolIcon Symbol="Previous20" Filled="True" Foreground="White"/>
                    </controls:Button>
                    <controls:Button x:Name="BtnPlay" Height="36" Width="44" Margin="12,0"
                                     Click="PlayPause_Click" Focusable="False"
                                     Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                        <ui:SymbolIcon x:Name="PlayGlyph" Symbol="Pause16" Filled="True" Foreground="White"/>
                    </controls:Button>
                    <controls:Button x:Name="BtnNext" Height="36" Width="44" Margin="12,0"
                                     Click="Next_Click" Focusable="False"
                                     Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                        <ui:SymbolIcon Symbol="Next20" Filled="True" Foreground="White"/>
                    </controls:Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
