<Window x:Class="FluentFlyoutWPF.Windows.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:MicaWPF.Controls;assembly=MicaWPF"
        Width="640" Height="240" Top="-9999"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Topmost="True"
        Loaded="Window_Loaded">
    <!-- Fluent Island de caja única: UNA sola Border cuyo tamaño interpola un muelle
         por frame (sin Storyboards, sin swaps de Visibility entre dos cajas: esa era
         la fuente del parpadeo). La ventana es de tamaño fijo para no re-maquetar a
         nivel OS; la ventana transparente fija mide 640 px y la zona muerta es click-through (Background null); solo la isla
         y la franja hover capturan el ratón. -->
    <Grid x:Name="Root" Background="{x:Null}">
        <!-- Línea gris opcional: indica que el Island está activo -->
        <Border x:Name="ActivityLine" Height="3" Width="120" CornerRadius="1.5"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0"
                Background="#66FFFFFF" Visibility="Collapsed"/>
        <Border x:Name="MediaStatusDot" Width="3" Height="3" CornerRadius="1.5"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0"
                Visibility="Collapsed" IsHitTestVisible="False"/>
        <!-- Franja de detección (001 MOD RF-10): mantiene la zona activa cuando hay
             una funcionalidad habilitada accesible por clic; por sí sola nunca
             despliega contenido: el clic en la pieza inactiva es el que abre. -->
        <Border x:Name="HoverStrip" Height="12" Width="120" HorizontalAlignment="Center" VerticalAlignment="Top" Background="Transparent"
                MouseLeftButtonUp="InactiveBorder_Click"/>

        <!-- Pieza inactiva (001 MOD RF-11, RF-16): pill negra más estrecha que el
             compacto, sin contenido; el hover solo la agranda (micro-crecimiento
             vivo) y el clic abre la última usable. Va DETRÁS de la caja: la caja
             la tapa cuando muestra compacto o expandido. -->
        <Border x:Name="InactiveBorder" Width="112" Height="34" CornerRadius="17"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="Black" BorderBrush="#22FFFFFF" BorderThickness="1"
                Cursor="Hand" Visibility="Collapsed"
                MouseLeftButtonUp="InactiveBorder_Click"
                MouseEnter="Box_MouseEnter" MouseLeave="Box_MouseLeave"/>

        <!-- La caja: Width 240/200<->ancho configurado y Height 34<->expandido animados por código.
             ClipToBounds para que el contenido florezca desde dentro al crecer.
             Las flechas laterales cambian de funcionalidad (temporizador) y solo
             aparecen en expandido con su toggle y más de un modo disponible. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
            <controls:Button x:Name="ModePrevBtn" Width="28" Height="28" Margin="0,0,4,0" Padding="0"
                             VerticalAlignment="Center" Visibility="Collapsed" Focusable="False" Click="ModeArrow_Click"
                             Style="{StaticResource MicaWPF.Styles.TransparentButton}" ToolTip="Funcionalidad anterior">
                <ui:SymbolIcon Symbol="ChevronLeft24" Filled="True" Foreground="White" FontSize="16"/>
            </controls:Button>
            <Border x:Name="IslandBox" Width="240" Height="34" CornerRadius="17"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="Black" BorderBrush="#33FFFFFF" BorderThickness="1"
                Visibility="Collapsed" ClipToBounds="True" RenderTransformOrigin="0.5,0.5"
                MouseEnter="Box_MouseEnter" MouseLeave="Box_MouseLeave" MouseWheel="IslandBox_Wheel"
                MouseLeftButtonUp="HandleIslandClick">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BoxScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="BoxTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <!-- The album art is used as a clipped viewport background, just like
                     the taskbar widget. The second layer keeps song changes smooth. -->
                <Canvas x:Name="BackgroundCanvas" IsHitTestVisible="False">
                    <Image x:Name="BackgroundImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                        <Image.Effect>
                            <BlurEffect x:Name="BackgroundImageBlurEffect" Radius="35" />
                        </Image.Effect>
                    </Image>
                    <Image x:Name="BackgroundImageNext" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                        <Image.Effect>
                            <BlurEffect x:Name="BackgroundImageNextBlurEffect" Radius="35" />
                        </Image.Effect>
                    </Image>
                </Canvas>

                <!-- Capa compacta: carátula izquierda + título + ecualizador -->
                <Grid x:Name="CompactLayer" Width="240" Height="34"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="CompactScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    <Grid x:Name="MusicCompactGrid" Margin="6,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CompactArtWrap" Grid.Column="0" Width="22" Height="22" CornerRadius="12" ClipToBounds="True"
                                Background="#222" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Cursor="Hand" ToolTip="Cambiar de medio" MouseLeftButtonUp="Album_Click"
                                MouseEnter="AlbumArt_MouseEnter" MouseLeave="AlbumArt_MouseLeave"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CompactArtFlipScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="CompactArtTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Grid>
                                <Image x:Name="CompactArt" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CompactNote" Text="♪" Foreground="White" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <Border x:Name="CompactAlbumOverlay" CornerRadius="12" ClipToBounds="True" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False">
                                    <ui:SymbolIcon Symbol="ChevronRight20" Filled="True" Foreground="White" FontSize="14"/>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="CompactTitle" Grid.Column="1" Foreground="White" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis"
                                   Cursor="Hand" ToolTip="Ver detalles"
                                   MouseLeftButtonUp="CompactMiddle_Click"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CompactTitleScale2" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="CompactTitleTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <Grid Grid.Column="2" Width="36" Height="16" Background="Transparent"
                              Cursor="Hand" ToolTip="Reproducir/pausar"
                              MouseLeftButtonUp="EqZone_Click">
                            <Image x:Name="CompactEq" Width="36" Height="16" Stretch="Uniform"
                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <TranslateTransform x:Name="CompactEqTranslate" X="0" Y="0"/>
                                </Image.RenderTransform>
                            </Image>
                            <controls:Button x:Name="EqPlayPauseBtn" Width="36" Height="16" Padding="0"
                                    Visibility="Collapsed" Focusable="False" Click="EqZone_Click"
                                    Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                                <ui:SymbolIcon x:Name="EqPlayPauseGlyph" Symbol="Pause16" Filled="True" Foreground="White" FontSize="14"/>
                            </controls:Button>
                        </Grid>
                    </Grid>
                    <!-- Temporizador en compacto: icono izquierda + progreso centro + restante derecha -->
                    <Grid x:Name="TimerCompactGrid" Margin="6,0,10,0" Visibility="Collapsed"
                          Cursor="Hand" ToolTip="Ver temporizador" MouseLeftButtonUp="TimerCompact_Click">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Timer20" Filled="True" Foreground="White" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Grid x:Name="TimerProgressZone" Grid.Column="1" Margin="8,0,4,0" Height="14" VerticalAlignment="Center">
                            <Border x:Name="TimerProgressTrack" Height="5" CornerRadius="2.5" Background="#3F3F3F" VerticalAlignment="Center"/>
                            <Border x:Name="TimerProgressFill" Width="0" Height="5" CornerRadius="2.5" Background="#969696"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="TimerRemaining" Grid.Column="2" Text="00:00:00" Foreground="White" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- Capa expandida: tarjeta compacta con carátula + título/artista + tiempos + controles.
                     Siempre Visible (medible) y gobernada por opacidad; el hit-test lo
                     decide el código según el progreso del morph. -->
                <StackPanel x:Name="ExpandedLayer" Margin="16,12,16,6" Opacity="0">
                    <Grid x:Name="MusicExpandedTop">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ExpandedArtWrap" Grid.Column="0" Width="48" Height="48" CornerRadius="12" ClipToBounds="True" Background="#222"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Cursor="Hand" ToolTip="Cambiar de medio" MouseLeftButtonUp="Album_Click"
                                 MouseEnter="AlbumArt_MouseEnter" MouseLeave="AlbumArt_MouseLeave"
                                 RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ExpandedArtFlipScale" ScaleX="1" ScaleY="1"/>
                                    <ScaleTransform x:Name="ExpandedArtScale" ScaleX="1" ScaleY="1"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Grid>
                                <Image x:Name="ExpandedArt" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ExpandedNote" Text="♪" Foreground="White" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <Border x:Name="ExpandedAlbumOverlay" CornerRadius="12" ClipToBounds="True" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False">
                                    <ui:SymbolIcon Symbol="ChevronRight20" Filled="True" Foreground="White" FontSize="18"/>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SongTitle" Text="Título desconocido" Foreground="White"
                                       FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       RenderTransformOrigin="0,0.5">
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="SongTitleScale" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="SongTitleTranslate" X="0" Y="0"/>
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="SongArtist" Text="Artista desconocido" Foreground="White"
                                       FontSize="10" Opacity="0.5" TextTrimming="CharacterEllipsis"
                                       RenderTransformOrigin="0,0.5">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="SongArtistTranslate" X="0" Y="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                        <Image x:Name="ExpandedEq" Grid.Column="2" Width="36" Height="16" Stretch="Uniform"
                               VerticalAlignment="Center" Margin="6,0,2,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <Grid x:Name="SeekRow" Margin="0,8,0,0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="SeekTranslate" X="0" Y="0"/>
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PosText" Grid.Column="0" Text="0:00" Foreground="White" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                        <Grid x:Name="TimelineHost" Grid.Column="1" Margin="8,0,8,0" Height="14"
                              VerticalAlignment="Center" SizeChanged="TimelineHost_SizeChanged">
                            <Border x:Name="TimelineTrack" Height="5" CornerRadius="2.5" Background="#3F3F3F"
                                    VerticalAlignment="Center"/>
                            <Border x:Name="TimelineProgress" Width="0" Height="5" CornerRadius="2.5" Background="#969696"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <!-- Transparent hit target over the custom track. The reference design
                                 has no permanent thumb, so the native thumb is effectively hidden. -->
                            <Slider x:Name="Seekbar" Minimum="0" Maximum="100" Value="0" Opacity="0.01"
                                    VerticalAlignment="Stretch"
                                    PreviewMouseLeftButtonDown="Seekbar_Down" PreviewMouseLeftButtonUp="Seekbar_Up"
                                    ValueChanged="Seekbar_ValueChanged"/>
                        </Grid>
                        <TextBlock x:Name="DurText" Grid.Column="2" Text="0:00" Foreground="White" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel x:Name="ControlsRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="ControlsTranslate" X="0" Y="0"/>
                        </StackPanel.RenderTransform>
                        <controls:Button x:Name="BtnPrev" Height="32" Width="32" Margin="4,0" Padding="0"
                                         Click="Prev_Click" Focusable="False"
                                         Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                            <ui:SymbolIcon Symbol="Previous20" Filled="True" Foreground="White" FontSize="22"/>
                        </controls:Button>
                        <controls:Button x:Name="BtnPlay" Height="36" Width="36" Margin="4,0" Padding="0"
                                         Click="PlayPause_Click" Focusable="False"
                                         Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                            <ui:SymbolIcon x:Name="PlayGlyph" Symbol="Pause16" Filled="True" Foreground="White" FontSize="20"/>
                        </controls:Button>
                        <controls:Button x:Name="BtnNext" Height="32" Width="32" Margin="4,0" Padding="0"
                                          Click="Next_Click" Focusable="False"
                                          Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                            <ui:SymbolIcon Symbol="Next20" Filled="True" Foreground="White" FontSize="22"/>
                        </controls:Button>
                    </StackPanel>
                    <!-- Temporizador en expandido: tiempo libre + controles a la izquierda, presets a la derecha -->
                    <StackPanel x:Name="TimerExpanded" Visibility="Collapsed">
                        <Grid x:Name="TimerConfigGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <!-- Reels infinitos H:M:S: arrastrar o rueda (arriba reduce, abajo aumenta).
                                     Sin teclado: la ventana es NoActivate y jamás tiene foco. -->
                                <Grid x:Name="TimerReels" HorizontalAlignment="Left" Cursor="SizeNS"
                                      ToolTip="Arrastra o usa la rueda para ajustar" MouseWheel="Reel_Wheel">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ReelH" Tag="H" Grid.Column="0" Text="00" FontSize="24" FontWeight="SemiBold"
                                               Foreground="White" MinWidth="44" TextAlignment="Center"
                                               PreviewMouseLeftButtonDown="Reel_Down" PreviewMouseMove="Reel_Move" PreviewMouseLeftButtonUp="Reel_Up"/>
                                    <TextBlock Grid.Column="1" Text=":" FontSize="24" Foreground="White" Opacity="0.5" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ReelM" Tag="M" Grid.Column="2" Text="00" FontSize="24" FontWeight="SemiBold"
                                               Foreground="White" MinWidth="44" TextAlignment="Center"
                                               PreviewMouseLeftButtonDown="Reel_Down" PreviewMouseMove="Reel_Move" PreviewMouseLeftButtonUp="Reel_Up"/>
                                    <TextBlock Grid.Column="3" Text=":" FontSize="24" Foreground="White" Opacity="0.5" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ReelS" Tag="S" Grid.Column="4" Text="00" FontSize="24" FontWeight="SemiBold"
                                               Foreground="White" MinWidth="44" TextAlignment="Center"
                                               PreviewMouseLeftButtonDown="Reel_Down" PreviewMouseMove="Reel_Move" PreviewMouseLeftButtonUp="Reel_Up"/>
                                </Grid>
                                <TextBlock x:Name="TimerStatus" FontSize="11" Opacity="0.6" Foreground="White" Text="" Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <controls:Button x:Name="TimerStartBtn" Content="Iniciar" Height="28" Margin="0,0,4,0" Padding="10,0"
                                                     Foreground="White" Focusable="False" Click="TimerStart_Click"
                                                     Style="{StaticResource MicaWPF.Styles.TransparentButton}"/>
                                    <controls:Button x:Name="TimerRestartBtn" Content="Reiniciar" Height="28" Padding="10,0"
                                                     Foreground="White" Focusable="False" Click="TimerRestart_Click" Visibility="Collapsed"
                                                     Style="{StaticResource MicaWPF.Styles.TransparentButton}"/>
                                </StackPanel>
                            </StackPanel>
                            <ListBox x:Name="TimerPresetList" Grid.Column="1" MaxHeight="112" Margin="8,0,0,0"
                                     Background="Transparent" BorderThickness="0" Foreground="White"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="TimerPresetList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,1,0,3">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="White"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="118"/>
                                            <TextBlock Text="{Binding DurationText}" FontSize="11" Opacity="0.6" Foreground="White"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </StackPanel>
                    <!-- Corriendo/pausado: iconos a la izquierda; origen + restante a la derecha -->
                    <Grid x:Name="TimerRunPanel" Visibility="Collapsed" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <controls:Button x:Name="TimerRunPauseBtn" Height="36" Width="36" Padding="0"
                                         Focusable="False" Click="TimerPause_Click" ToolTip="Pausar/Reanudar"
                                         Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                            <ui:SymbolIcon x:Name="TimerRunPauseGlyph" Symbol="Pause24" Filled="True" Foreground="White" FontSize="20"/>
                        </controls:Button>
                        <controls:Button x:Name="TimerRunCancelBtn" Height="36" Width="36" Padding="0"
                                         Focusable="False" Click="TimerCancel_Click" ToolTip="Cancelar"
                                         Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                            <ui:SymbolIcon Symbol="Dismiss24" Filled="True" Foreground="White" FontSize="20"/>
                        </controls:Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock x:Name="TimerRunOrigin" FontSize="11" Opacity="0.6" Foreground="White" Text="Timer" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="TimerRunRemaining" FontSize="22" FontWeight="SemiBold" Foreground="White" Text="00:00:00" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                    <!-- Aviso al llegar a cero: reiniciar + X a la izquierda, origen a la derecha -->
                    <Grid x:Name="TimerAlert" Visibility="Collapsed" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <controls:Button x:Name="TimerAlertRestartBtn" Height="36" Width="36" Padding="0"
                                         Focusable="False" Click="TimerAlertRestart_Click" ToolTip="Reiniciar"
                                         Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" Filled="True" Foreground="White" FontSize="20"/>
                        </controls:Button>
                        <controls:Button x:Name="TimerAlertDismissBtn" Height="36" Width="36" Padding="0"
                                         Focusable="False" Click="TimerAlertDismiss_Click" ToolTip="Terminar"
                                         Style="{StaticResource MicaWPF.Styles.TransparentButton}">
                            <ui:SymbolIcon Symbol="Dismiss24" Filled="True" Foreground="White" FontSize="20"/>
                        </controls:Button>
                        </StackPanel>
                        <TextBlock x:Name="TimerAlertName" Grid.Column="1" Text="Timer" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
            <controls:Button x:Name="ModeNextBtn" Width="28" Height="28" Margin="4,0,0,0" Padding="0"
                             VerticalAlignment="Center" Visibility="Collapsed" Focusable="False" Click="ModeArrow_Click"
                             Style="{StaticResource MicaWPF.Styles.TransparentButton}" ToolTip="Funcionalidad siguiente">
                <ui:SymbolIcon Symbol="ChevronRight24" Filled="True" Foreground="White" FontSize="16"/>
            </controls:Button>
        </StackPanel>
    </Grid>
</Window>
