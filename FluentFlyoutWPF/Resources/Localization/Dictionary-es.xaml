    <system:String x:Key="IslandPage_AlbumBackground">Fondo del álbum</system:String>
    <system:String x:Key="IslandPage_AlbumBackgroundDesc">Añade desenfoque y el fondo giratorio del álbum detrás del Island.</system:String>
    <system:String x:Key="IslandPage_BackgroundIntensity">Intensidad del fondo</system:String>
