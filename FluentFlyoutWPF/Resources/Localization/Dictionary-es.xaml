    <system:String x:Key="IslandPage_ClipboardTitle">Historial del portapapeles</system:String>
    <system:String x:Key="IslandPage_ClipboardDesc">Todo lo que copies (texto o imagen) queda en el Island: haz clic en una pieza y se copia de nuevo para pegarla con Ctrl+V donde quieras.</system:String>
    <system:String x:Key="IslandPage_Keep">Guardar</system:String>
    <system:String x:Key="IslandPage_Pieces">piezas</system:String>
    <system:String x:Key="IslandPage_ClipboardNote">Lo guardado vive solo en memoria: se pierde al cerrar la app y nunca sale de tu equipo. Al bajar el tope se descartan las piezas más viejas.</system:String>
    <system:String x:Key="IslandPage_WeatherSection">Clima</system:String>
    <system:String x:Key="IslandPage_WeatherTitle">Clima del lugar que elijas</system:String>
    <system:String x:Key="IslandPage_WeatherDesc">Muestra el clima actual en el Island: el glifo del cielo y la temperatura en compacto, y el lugar, el estado y los extremos del día en expandido. Se actualiza solo cada cuarto de hora.</system:String>
    <system:String x:Key="IslandPage_WeatherPlaceholder">Ciudad o lugar (p. ej. Vigo)</system:String>
    <system:String x:Key="IslandPage_Search">Buscar</system:String>
    <system:String x:Key="IslandPage_WeatherHint">Escribe al menos dos letras y busca: elige el lugar correcto entre las sugerencias.</system:String>
    <system:String x:Key="IslandPage_NoPlace">Sin lugar elegido</system:String>
    <system:String x:Key="IslandPage_RefreshNow">Actualizar ahora</system:String>
    <system:String x:Key="IslandPage_WeatherNote">El lugar viaja a Open-Meteo (servicio meteorológico abierto, sin cuenta ni clave): es lo único que sale de tu equipo. Apagado no se consulta nada.</system:String>
    <system:String x:Key="IslandPage_PowerSection">Energía</system:String>
    <system:String x:Key="IslandPage_PowerTitle">Cargador conectado y desconectado</system:String>
    <system:String x:Key="IslandPage_PowerDesc">Avisa en el Island cuando el equipo se enchufa a la corriente (rayo verde y porcentaje de batería) y cuando se queda a batería (rayo rojo y el último porcentaje). El aviso siempre es temporal.</system:String>
    <system:String x:Key="IslandPage_PowerNote">Un equipo sin batería (un sobremesa) no avisa: ahí enchufar o desenchufar no significa nada. Sin nivel conocido se enseña el texto sin el porcentaje, en vez de un 0 % inventado.</system:String>
