    <!-- Fluent Island: página de ajustes. -->
    <system:String x:Key="IslandPage_Intro">Contenedor superior central para el contenido activo: muestra música, temporizador y el cajón de aplicaciones. Haz clic para abrir detalles y controles.</system:String>
    <system:String x:Key="IslandPage_GeneralSection">Generales del contenedor</system:String>
    <system:String x:Key="IslandPage_EnableTitle">Habilitar Fluent Island</system:String>
    <system:String x:Key="IslandPage_EnableDesc">Muestra el contenedor arriba al centro para el contenido activo: música, temporizador y aplicaciones.</system:String>
    <system:String x:Key="IslandPage_Animations">Animaciones</system:String>
    <system:String x:Key="IslandPage_AnimationsDesc">Transiciones del Island (aparición y morph).</system:String>
    <system:String x:Key="IslandPage_Visibility">Visibilidad</system:String>
    <system:String x:Key="IslandPage_VisibilityDesc">Visible mientras haya actividad, o aviso temporal al evento.</system:String>
    <system:String x:Key="IslandPage_ModeActive">Visible mientras activo</system:String>
    <system:String x:Key="IslandPage_ModeTemporary">Aviso temporal</system:String>
    <system:String x:Key="IslandPage_NoticeDuration">Duración del aviso</system:String>
    <system:String x:Key="IslandPage_NoticeDurationDesc">Segundos que permanece visible al reproducir en aviso temporal.</system:String>
    <system:String x:Key="IslandPage_ReturnToInactive">Volver a inactivo</system:String>
    <system:String x:Key="IslandPage_ReturnToInactiveDesc">Al vencer el aviso o caer sin actividad, muestra la pieza inactiva (negra estrecha) en vez de ocultarse por completo.</system:String>
    <system:String x:Key="IslandPage_UltraCompact">Ultra compacto</system:String>
    <system:String x:Key="IslandPage_UltraCompactDesc">Con la cápsula replegada solo se ven sus dos extremos (en el control de medios, la carátula y el ecualizador). Pensado para «Volver a inactivo» apagado: el Island aparece solo cuando algo hay que enseñar y, como no queda pieza en pantalla, se asoma al poner el puntero en la franja de arriba.</system:String>
    <system:String x:Key="IslandPage_HideFullscreen">Ocultar a pantalla completa</system:String>
    <system:String x:Key="IslandPage_HideFullscreenDesc">El Island se aparta con un juego o un vídeo a pantalla completa (también sin bordes), en una presentación o con el equipo bloqueado. El ajuste es del Island: no depende del de las notificaciones.</system:String>
    <system:String x:Key="IslandPage_ScreensSection">Pantallas</system:String>
    <system:String x:Key="IslandPage_ScreensTitle">Pantallas del Island</system:String>
    <system:String x:Key="IslandPage_ScreensDesc">Agrupa funcionalidades en pantallas: la rueda y las flechas las recorren en orden. En el compacto la pantalla enseña UNA sola funcionalidad —la que está activa— y al hacer clic en ella se abre la pantalla entera: todas sus funcionalidades en columnas de izquierda a derecha, con ancho y alto dinámicos, en el orden de las tarjetas. Con una sola funcionalidad la pantalla se ve como siempre.</system:String>
    <system:String x:Key="IslandPage_NewScreen">Nueva pantalla</system:String>
    <system:String x:Key="IslandPage_NewScreenTip">Nace con la primera funcionalidad que todavía no esté asignada a una pantalla</system:String>
    <system:String x:Key="IslandPage_ScreensNote">No hace falta una pantalla por funcionalidad: agrupa en cada una las que quieras ver juntas (hasta 4, que son las columnas que caben en el expandido del Island, de izquierda a derecha). Cada funcionalidad solo puede pertenecer a una pantalla; una pantalla vacía no se guarda. El orden de las tarjetas es el de esas columnas y los cambios se ven al momento si el Island está a la vista. Bluetooth y el cargador no aparecen aquí: son avisos de un evento (un dispositivo que se conecta, el equipo que se enchufa) y se presentan solos, sin ocupar ninguna pantalla.</system:String>
    <system:String x:Key="IslandPage_MusicSection">Música</system:String>
    <system:String x:Key="IslandPage_Equalizer">Ecualizador</system:String>
    <system:String x:Key="IslandPage_EqualizerDesc">Barras con el audio real en la isla compacta y expandida.</system:String>
    <system:String x:Key="IslandPage_BarCount">Número de barras</system:String>
    <system:String x:Key="IslandPage_CenteredBars">Barras centradas</system:String>
    <system:String x:Key="IslandPage_CenteredBarsDesc">Refleja cada barra arriba y abajo del centro del ecualizador.</system:String>
    <system:String x:Key="IslandPage_Sensitivity">Sensibilidad</system:String>
    <system:String x:Key="IslandPage_Smoothing">Suavizado</system:String>
    <system:String x:Key="IslandPage_Style">Estilo</system:String>
    <system:String x:Key="IslandPage_StyleDesc">Notch: la isla sale del borde superior como la referencia.</system:String>
    <system:String x:Key="IslandPage_StyleFloating">Isla flotante</system:String>
    <system:String x:Key="IslandPage_StyleNotch">Notch superior</system:String>
    <system:String x:Key="IslandPage_ToleranceVertical">Alcance vertical</system:String>
    <system:String x:Key="IslandPage_ToleranceVerticalDesc">Píxeles hacia abajo desde la línea. 0 = solo sobre la línea.</system:String>
    <system:String x:Key="IslandPage_ToleranceHorizontal">Alcance horizontal</system:String>
    <system:String x:Key="IslandPage_ToleranceHorizontalDesc">Píxeles a cada lado de la línea. 0 = ancho de la línea (120 px).</system:String>
    <system:String x:Key="IslandPage_ShowOnPlay">Mostrar al reproducir</system:String>
    <system:String x:Key="IslandPage_ShowOnPlayDesc">Muestra el Island al iniciar o reanudar el medio durante el tiempo configurado.</system:String>
    <system:String x:Key="IslandPage_ShowOnPause">Mostrar al pausar</system:String>
    <system:String x:Key="IslandPage_ShowOnPauseDesc">Muestra el Island al pausar el medio durante el tiempo configurado.</system:String>
    <system:String x:Key="IslandPage_ShowOnTrackChange">Mostrar al cambiar de canción</system:String>
    <system:String x:Key="IslandPage_ShowOnTrackChangeDesc">Muestra el Island cuando cambia la canción o sus metadatos.</system:String>
    <system:String x:Key="IslandPage_PauseCountsActive">Pausa de media cuenta como activo</system:String>
    <system:String x:Key="IslandPage_PauseCountsActiveDesc">En «Visible mientras activo», una sesión pausada sostiene la visibilidad con sus controles; desactívalo para que la pausa no cuente como actividad.</system:String>
    <system:String x:Key="IslandPage_ExpandTrigger">Expandir con rueda</system:String>
    <system:String x:Key="IslandPage_ExpandTriggerDesc">La rueda hacia abajo sobre la isla compacta también expande; hacia arriba colapsa.</system:String>
