    <system:String x:Key="IslandPage_TriggerWheel">Rueda</system:String>
    <system:String x:Key="IslandPage_TriggerBoth">Ambos</system:String>
    <system:String x:Key="IslandPage_TypographyTitle">Tipografía y estilo de texto</system:String>
    <system:String x:Key="IslandPage_TypographyDesc">Fuente y tamaños de los textos del Island. La fuente es compartida por los 3 textos.</system:String>
    <system:String x:Key="IslandPage_Typography">Tipografía</system:String>
    <system:String x:Key="IslandPage_TypographyNote">Las incluidas funcionan en cualquier PC. También puedes elegir una del sistema o escribir cualquier fuente instalada</system:String>
