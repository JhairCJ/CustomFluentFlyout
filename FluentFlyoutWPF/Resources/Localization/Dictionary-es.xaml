    <system:String x:Key="AlbumAccentDesaturationAmountTitle">Cantidad</system:String>
    <system:String x:Key="AlbumAccentDesaturationAmountDescription">Cuánto se rebaja la saturación por encima del umbral. 0 conserva el color original; 100 aplana todo lo que está por encima del umbral hasta él. Los colores por debajo del umbral no se tocan.</system:String>
