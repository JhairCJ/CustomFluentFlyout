    <system:String x:Key="AlbumAccentDesaturationTitle">Desaturación del color de acento</system:String>
    <system:String x:Key="AlbumAccentDesaturationDescription">Domestica los colores de álbum demasiado intensos. Desaturar reduce la intensidad del color hacia el gris sin cambiar el brillo.</system:String>
