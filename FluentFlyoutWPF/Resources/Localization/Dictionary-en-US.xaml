    <System:String x:Key="IslandPage_ExpandedTitleSize">Song text in expanded island</System:String>
    <System:String x:Key="IslandPage_ExpandedArtistSize">Artist text in expanded island</System:String>
    <System:String x:Key="IslandPage_AppearanceSection">Appearance</System:String>
    <System:String x:Key="IslandPage_ExpandedWidth">Expanded width</System:String>
    <System:String x:Key="IslandPage_ExpandedWidthDesc">Pixel width of the Island when it shows the controls.</System:String>
    <System:String x:Key="IslandPage_FloatingHeight">Floating island height</System:String>
    <System:String x:Key="IslandPage_FloatingHeightDesc">Pixel height of the expanded Island; it only applies to the floating island.</System:String>
    <System:String x:Key="IslandPage_IslandOffset">Island offset</System:String>
    <System:String x:Key="IslandPage_IslandOffsetDesc">How far down the island sits from the top edge, like on iPhone. Floating island only.</System:String>
    <System:String x:Key="IslandPage_LineOffset">Grey line offset</System:String>
    <System:String x:Key="IslandPage_LineOffsetDesc">How far down the grey line sits from the top edge. Floating island only.</System:String>
    <System:String x:Key="IslandPage_CompactRadius">Compact radius</System:String>
    <System:String x:Key="IslandPage_CompactRadiusDesc">Rounds the outer edge on the compact island.</System:String>
    <System:String x:Key="IslandPage_ExpandedRadius">Expanded radius</System:String>
    <System:String x:Key="IslandPage_ExpandedRadiusDesc">Rounds the outer edge on the expanded island.</System:String>
    <System:String x:Key="IslandPage_NotchFilletCompact">Edge curve in compact</System:String>
    <System:String x:Key="IslandPage_NotchFilletCompactDesc">How much the island opens toward the top edge in compact. Notch mode only.</System:String>
    <System:String x:Key="IslandPage_NotchFilletExpanded">Edge curve in expanded</System:String>
    <System:String x:Key="IslandPage_NotchFilletExpandedDesc">How much the island opens toward the top edge in expanded. Notch mode only.</System:String>
    <System:String x:Key="IslandPage_AlbumArtRadius">Artwork radius</System:String>
    <System:String x:Key="IslandPage_AlbumArtRadiusDesc">Rounds the corners of the album and of the change-media arrow.</System:String>
    <System:String x:Key="IslandPage_WhiteBorder">White border</System:String>
    <System:String x:Key="IslandPage_WhiteBorderDesc">Shows the translucent white border around the Island.</System:String>
    <System:String x:Key="IslandPage_AlbumBackground">Album background</System:String>
    <System:String x:Key="IslandPage_AlbumBackgroundDesc">Adds blur and the rotating album background behind the Island.</System:String>
    <System:String x:Key="IslandPage_BackgroundIntensity">Background intensity</System:String>
    <System:String x:Key="IslandPage_BackgroundIntensityDesc">How visible the artwork stays behind the content.</System:String>
    <System:String x:Key="IslandPage_BlurRadius">Blur radius</System:String>
    <System:String x:Key="IslandPage_BlurRadiusDesc">Sets how much the artwork is blurred.</System:String>
    <System:String x:Key="IslandPage_RotatingBackground">Rotating background</System:String>
    <System:String x:Key="IslandPage_RotatingBackgroundDesc">Slowly spins the blurred artwork behind the Island.</System:String>
    <System:String x:Key="IslandPage_DiscSide">Album side</System:String>
    <System:String x:Key="IslandPage_DiscSideDesc">Pick which side of the spinning disc is shown.</System:String>
    <System:String x:Key="IslandPage_SideLeft">Left</System:String>
    <System:String x:Key="IslandPage_SideRight">Right</System:String>
    <System:String x:Key="IslandPage_SpinDirection">Spin direction</System:String>
    <System:String x:Key="IslandPage_SpinDirectionDesc">Pick whether the album spins down or up.</System:String>
    <System:String x:Key="IslandPage_SpinDown">Down</System:String>
    <System:String x:Key="IslandPage_SpinUp">Up</System:String>
    <System:String x:Key="IslandPage_SpinDuration">Spin time</System:String>
    <System:String x:Key="IslandPage_SpinDurationDesc">How many seconds a full turn takes.</System:String>
    <System:String x:Key="IslandPage_DiscSize">Disc size</System:String>
    <System:String x:Key="IslandPage_DiscSizeDesc">Size of the spinning disc relative to the Island.</System:String>
    <System:String x:Key="IslandPage_HighRefresh">High refresh rate</System:String>
    <System:String x:Key="IslandPage_HighRefreshDesc">Uses the monitor refresh rate; off caps the spin at 30 FPS.</System:String>
    <System:String x:Key="IslandPage_ContentSection">Island content</System:String>
    <System:String x:Key="IslandPage_MediaTitle">Media controls</System:String>
    <System:String x:Key="IslandPage_MediaDesc">Adds media controls to the Island features; switch with the wheel or the arrows.</System:String>
    <System:String x:Key="IslandPage_TimerSection">Timer</System:String>
    <System:String x:Key="IslandPage_EnableTimer">Enable timer</System:String>
    <System:String x:Key="IslandPage_EnableTimerDesc">Adds the timer to the Island features; switch with the wheel or the arrows.</System:String>
    <System:String x:Key="IslandPage_TimerProgress">Progress in compact</System:String>
    <System:String x:Key="IslandPage_TimerProgressDesc">Shows the countdown progress in the center of the compact Island.</System:String>
    <System:String x:Key="IslandPage_SideArrows">Side arrows</System:String>
    <System:String x:Key="IslandPage_SideArrowsDesc">Shows arrows on the sides of the expanded Island to switch feature.</System:String>
    <System:String x:Key="IslandPage_Presets">Presets</System:String>
    <System:String x:Key="IslandPage_PresetsDesc">Reusable names and durations (max. 10). Duration uses 00:00:00.</System:String>
    <System:String x:Key="IslandPage_Remove">Remove</System:String>
    <System:String x:Key="IslandPage_AddPreset">Add preset</System:String>
    <System:String x:Key="IslandPage_AppsSection">Applications</System:String>
    <System:String x:Key="IslandPage_AppsTitle">App drawer</System:String>
    <System:String x:Key="IslandPage_AppsDesc">Adds apps to the Island; click their icon to launch them (max. 12).</System:String>
    <System:String x:Key="IslandPage_AddApp">Add app</System:String>
    <System:String x:Key="IslandPage_ShelfSection">File shelf</System:String>
    <System:String x:Key="IslandPage_ShelfTitle">Island shelf</System:String>
    <System:String x:Key="IslandPage_ShelfDesc">Drop files or folders on the Island to park them and drag them out from there to remove them. They never expire: removing them returns them to their original folder (max. 24).</System:String>
    <System:String x:Key="IslandPage_ShelfItemRemoveTip">Returns it to its original folder</System:String>
    <System:String x:Key="IslandPage_ParkFiles">Park files…</System:String>
    <System:String x:Key="IslandPage_ParkFilesTip">Moves them to the shelf</System:String>
    <System:String x:Key="IslandPage_OpenFolder">Open folder</System:String>
    <System:String x:Key="IslandPage_ClearShelf">Empty shelf</System:String>
    <System:String x:Key="IslandPage_ClearShelfTip">Returns each item to its original folder</System:String>
    <System:String x:Key="IslandPage_CalendarSection">Calendar reminders</System:String>
    <System:String x:Key="IslandPage_CalendarTitle">Google Calendar reminders</System:String>
    <System:String x:Key="IslandPage_CalendarDesc">Notifies in the Island when a calendar event is about to start (read-only from your main calendar).</System:String>
    <System:String x:Key="IslandPage_CalendarOAuthNote">You need your own OAuth client: in Google Cloud Console create one of type «Desktop app», enable the Google Calendar API and add your account as a test user. Paste its id and secret here.</System:String>
    <System:String x:Key="IslandPage_ClientId">Client id</System:String>
    <System:String x:Key="IslandPage_ClientSecret">Client secret</System:String>
    <System:String x:Key="IslandPage_SignInGoogle">Sign in with Google</System:String>
    <System:String x:Key="IslandPage_SignOut">Sign out</System:String>
    <System:String x:Key="IslandPage_SyncNow">Sync now</System:String>
    <System:String x:Key="IslandPage_ConnectedAccount">Connected account</System:String>
    <System:String x:Key="IslandPage_RemindBefore">Remind before</System:String>
    <System:String x:Key="IslandPage_SyncEvery">Sync every</System:String>
    <System:String x:Key="IslandPage_ReadAhead">Read up to</System:String>
    <System:String x:Key="IslandPage_Days">days</System:String>
    <System:String x:Key="IslandPage_CalendarNote">It is a reminder: the next event is read from the main calendar and the notice appears in the Island only while signed in. Signing out deletes nothing from the calendar.</System:String>
    <System:String x:Key="IslandPage_BluetoothSection">Bluetooth devices</System:String>
    <System:String x:Key="IslandPage_BluetoothTitle">Connected Bluetooth devices</System:String>
    <System:String x:Key="IslandPage_BluetoothDesc">Notifies in the Island when a Bluetooth device connects: its icon, its name and its battery if the device reports it. The notice is always temporary and is withdrawn when the configured duration expires.</System:String>
    <System:String x:Key="IslandPage_BluetoothNote">The battery is only shown if Windows knows it for that device (headphones and speakers that report it); those that do not report it appear without a ring and with nothing in that area. A connection does not interrupt an expanded view you are looking at nor appears over a fullscreen game.</System:String>
    <System:String x:Key="IslandPage_ClipboardSection">Clipboard</System:String>
    <System:String x:Key="IslandPage_ClipboardTitle">Clipboard history</System:String>
    <System:String x:Key="IslandPage_ClipboardDesc">Everything you copy (text or image) stays in the Island: click a piece and it is copied again to paste it with Ctrl+V wherever you want.</System:String>
    <System:String x:Key="IslandPage_Keep">Keep</System:String>
    <System:String x:Key="IslandPage_Pieces">pieces</System:String>
    <System:String x:Key="IslandPage_ClipboardNote">What is kept lives only in memory: it is lost when the app closes and never leaves your PC. Lowering the cap discards the oldest pieces.</System:String>
    <System:String x:Key="IslandPage_WeatherSection">Weather</System:String>
    <System:String x:Key="IslandPage_WeatherTitle">Weather for the place you pick</System:String>
    <System:String x:Key="IslandPage_WeatherDesc">Shows the current weather in the Island: the sky glyph and the temperature in compact, and the place, the condition and the day's highs/lows in expanded. It updates itself every quarter of an hour.</System:String>
    <System:String x:Key="IslandPage_WeatherPlaceholder">City or place (e.g. Vigo)</System:String>
    <System:String x:Key="IslandPage_Search">Search</System:String>
    <System:String x:Key="IslandPage_WeatherHint">Type at least two letters and search: pick the right place among the suggestions.</System:String>
    <System:String x:Key="IslandPage_NoPlace">No place chosen</System:String>
    <System:String x:Key="IslandPage_RefreshNow">Refresh now</System:String>
    <System:String x:Key="IslandPage_WeatherNote">The place travels to Open-Meteo (open weather service, no account or key): it is the only thing that leaves your PC. Off, nothing is queried.</System:String>
    <System:String x:Key="IslandPage_PowerSection">Power</System:String>
    <System:String x:Key="IslandPage_PowerTitle">Charger connected and unplugged</System:String>
    <System:String x:Key="IslandPage_PowerDesc">Notifies in the Island when the PC is plugged into power (green bolt and battery percentage) and when it goes to battery (red bolt and the last percentage). The notice is always temporary.</System:String>
