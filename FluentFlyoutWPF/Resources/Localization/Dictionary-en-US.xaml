    <!-- Fluent Island: página de ajustes. -->
    <System:String x:Key="IslandPage_Intro">Central top container for the active content: it shows music, timer and the app drawer. Click to open details and controls.</System:String>
    <System:String x:Key="IslandPage_GeneralSection">Container general</System:String>
    <System:String x:Key="IslandPage_EnableTitle">Enable Fluent Island</System:String>
    <System:String x:Key="IslandPage_EnableDesc">Shows the top-center container for the active content: music, timer and apps.</System:String>
    <System:String x:Key="IslandPage_Animations">Animations</System:String>
    <System:String x:Key="IslandPage_AnimationsDesc">Island transitions (appearance and morph).</System:String>
    <System:String x:Key="IslandPage_Visibility">Visibility</System:String>
    <System:String x:Key="IslandPage_VisibilityDesc">Visible while there is activity, or a temporary notice on the event.</System:String>
    <System:String x:Key="IslandPage_ModeActive">Visible while active</System:String>
    <System:String x:Key="IslandPage_ModeTemporary">Temporary notice</System:String>
    <System:String x:Key="IslandPage_NoticeDuration">Notice duration</System:String>
    <System:String x:Key="IslandPage_NoticeDurationDesc">Seconds it stays visible on play in temporary-notice mode.</System:String>
    <System:String x:Key="IslandPage_ReturnToInactive">Return to inactive</System:String>
    <System:String x:Key="IslandPage_ReturnToInactiveDesc">When the notice expires or there is no activity, it shows the inactive pill (narrow black) instead of hiding completely.</System:String>
    <System:String x:Key="IslandPage_UltraCompact">Ultra compact</System:String>
    <System:String x:Key="IslandPage_UltraCompactDesc">With the pill collapsed only its two ends are shown (in media controls, the artwork and the equalizer). Meant for «Return to inactive» off: the Island only appears when there is something to show and, since no pill is left on screen, it peeks out when you put the pointer on the top strip.</System:String>
    <System:String x:Key="IslandPage_HideFullscreen">Hide on fullscreen</System:String>
    <System:String x:Key="IslandPage_HideFullscreenDesc">The Island steps aside for a fullscreen game or video (also borderless), during a presentation or with the PC locked. This setting belongs to the Island: it does not depend on the notifications one.</System:String>
    <System:String x:Key="IslandPage_ScreensSection">Screens</System:String>
    <System:String x:Key="IslandPage_ScreensTitle">Island screens</System:String>
    <System:String x:Key="IslandPage_ScreensDesc">Group features into screens: the wheel and the arrows cycle through them in order. In compact the screen shows ONE feature —the active one— and clicking it opens the whole screen: all its features in columns from left to right, with dynamic width and height, in the order of the cards. With a single feature the screen looks as always.</System:String>
    <System:String x:Key="IslandPage_NewScreen">New screen</System:String>
    <System:String x:Key="IslandPage_NewScreenTip">It starts with the first feature not yet assigned to a screen</System:String>
    <System:String x:Key="IslandPage_ScreensNote">There is no need for one screen per feature: group in each one the features you want to see together (up to 4, the columns that fit in the expanded Island, from left to right). Each feature can belong to only one screen; an empty screen is not saved. The order of the cards is the order of those columns and the changes show instantly if the Island is on screen. Bluetooth and the charger do not appear here: they are event notices (a device that connects, the PC being plugged in) and they present themselves, without taking up any screen.</System:String>
    <System:String x:Key="IslandPage_MusicSection">Music</System:String>
    <System:String x:Key="IslandPage_Equalizer">Equalizer</System:String>
    <System:String x:Key="IslandPage_EqualizerDesc">Bars with the real audio in the compact and expanded island.</System:String>
    <System:String x:Key="IslandPage_BarCount">Bar count</System:String>
    <System:String x:Key="IslandPage_CenteredBars">Centered bars</System:String>
    <System:String x:Key="IslandPage_CenteredBarsDesc">Mirrors each bar above and below the equalizer center.</System:String>
    <System:String x:Key="IslandPage_Sensitivity">Sensitivity</System:String>
    <System:String x:Key="IslandPage_Smoothing">Smoothing</System:String>
    <System:String x:Key="IslandPage_Style">Style</System:String>
    <System:String x:Key="IslandPage_StyleDesc">Notch: the island comes out of the top edge as in the reference.</System:String>
    <System:String x:Key="IslandPage_StyleFloating">Floating island</System:String>
    <System:String x:Key="IslandPage_StyleNotch">Top notch</System:String>
    <System:String x:Key="IslandPage_ToleranceVertical">Vertical reach</System:String>
    <System:String x:Key="IslandPage_ToleranceVerticalDesc">Pixels down from the line. 0 = only on the line.</System:String>
    <System:String x:Key="IslandPage_ToleranceHorizontal">Horizontal reach</System:String>
    <System:String x:Key="IslandPage_ToleranceHorizontalDesc">Pixels on each side of the line. 0 = line width (120 px).</System:String>
    <System:String x:Key="IslandPage_ShowOnPlay">Show on play</System:String>
    <System:String x:Key="IslandPage_ShowOnPlayDesc">Shows the Island when media starts or resumes for the configured time.</System:String>
    <System:String x:Key="IslandPage_ShowOnPause">Show on pause</System:String>
    <System:String x:Key="IslandPage_ShowOnPauseDesc">Shows the Island when media is paused for the configured time.</System:String>
    <System:String x:Key="IslandPage_ShowOnTrackChange">Show on track change</System:String>
    <System:String x:Key="IslandPage_ShowOnTrackChangeDesc">Shows the Island when the song or its metadata changes.</System:String>
    <System:String x:Key="IslandPage_PauseCountsActive">Paused media counts as active</System:String>
    <System:String x:Key="IslandPage_PauseCountsActiveDesc">In «Visible while active», a paused session sustains visibility with its controls; turn it off so a pause does not count as activity.</System:String>
    <System:String x:Key="IslandPage_ExpandTrigger">Expand with wheel</System:String>
    <System:String x:Key="IslandPage_ExpandTriggerDesc">The wheel down over the compact island also expands; up collapses.</System:String>
    <System:String x:Key="IslandPage_TriggerClick">Click</System:String>
    <System:String x:Key="IslandPage_TriggerWheel">Wheel</System:String>
    <System:String x:Key="IslandPage_TriggerBoth">Both</System:String>
    <System:String x:Key="IslandPage_TypographyTitle">Typography and text style</System:String>
    <System:String x:Key="IslandPage_TypographyDesc">Font and sizes of the Island texts. The font is shared by all 3 texts.</System:String>
    <System:String x:Key="IslandPage_Typography">Typography</System:String>
    <System:String x:Key="IslandPage_TypographyNote">The bundled ones work on any PC. You can also pick a system one or type any installed font</System:String>
    <System:String x:Key="IslandPage_FontsBundled">── Bundled fonts ──</System:String>
    <System:String x:Key="IslandPage_FontsSystem">── System fonts ──</System:String>
