<UserControl x:Class="FluentFlyout.Controls.TaskbarWidgetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:FluentFlyout.Controls"
             xmlns:viewModels="clr-namespace:FluentFlyoutWPF.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:UserSettings}"
             Height="40" Width="100"
              UseLayoutRounding="True" SnapsToDevicePixels="True"
              TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Display"
              FontFamily="{Binding TaskbarWidgetFontSource, FallbackValue='Segoe UI Variable'}"
              FlowDirection="{Binding FlowDirection}">
    <UserControl.ContextMenu>
        <ContextMenu Style="{StaticResource InstantContextMenu}" Opened="PlayerMenu_Opened" Closed="PlayerMenu_Closed" StaysOpen="False">
            <ui:MenuItem x:Name="OpenPlayerMenuItem" Header="{DynamicResource TaskbarOpenPlayerText}" Click="OpenPlayerMenuItem_Click">
                <ui:MenuItem.Icon><ui:SymbolIcon Symbol="Open20" /></ui:MenuItem.Icon>
            </ui:MenuItem>
        </ContextMenu>
    </UserControl.ContextMenu>
    <Border Name="MainBorder" CornerRadius="6" ClipToBounds="True">
        <Grid x:Name="RootGrid">
            <!-- Expansion opacity animates the color surface; its own opacity reveals the desktop. -->
            <Border x:Name="ExpandedBackdropBase" Opacity="0" IsHitTestVisible="False">
                <Border Background="{Binding TaskbarWidgetExpandedBackgroundColor, Converter={StaticResource HexColorToBrushConverter}}"
                        Opacity="{Binding TaskbarWidgetExpandedBackgroundTranslucency, Converter={StaticResource PercentageToOpacityConverter}, ConverterParameter=Translucency}" />
            </Border>
            <!-- The rotating background lives in a Canvas so it is arranged at its exact
                 square size, independent of the widget's rectangular layout slot. The widget
                 (MainBorder, ClipToBounds) acts purely as the viewport over that square. -->
            <Canvas x:Name="BackgroundCanvas" IsHitTestVisible="False">
                <Image x:Name="BackgroundImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5" Opacity="{Binding TaskbarWidgetBackgroundBlurIntensity, Converter={StaticResource PercentageToOpacityConverter}}">
                    <Image.Effect>
                        <BlurEffect x:Name="BackgroundImageBlurEffect" Radius="{Binding TaskbarWidgetBackgroundBlurRadius}" />
                    </Image.Effect>
                </Image>
                <!-- Incoming background layer, rendered on top of BackgroundImage. Song changes
                     crossfade complementarily (this layer 0 -> bound while BackgroundImage
                     goes bound -> 0), so the swap at completion is invisible. Parked (Collapsed) at rest. -->
                <Image x:Name="BackgroundImageNext" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" Opacity="{Binding TaskbarWidgetBackgroundBlurIntensity, Converter={StaticResource PercentageToOpacityConverter}}">
                    <Image.Effect>
                        <BlurEffect x:Name="BackgroundImageNextBlurEffect" Radius="{Binding TaskbarWidgetBackgroundBlurRadius}" />
                    </Image.Effect>
                </Image>
            </Canvas>
            <Border Name="TopBorder" BorderThickness="0,1.25,0,0" CornerRadius="5" Margin="0,0,0,1.25">
                <!-- The compact content is drawn 1:1. The 10% smaller look lives in the
                     metrics below (32.4 album art, 11.7/10.8 type, 28.8 buttons), never in a
                     render scale: a ScaleTransform re-rasterizes every glyph on a sub-pixel
                     phase, so stems split across two columns and the text reads as rough. -->
                <Grid Name="MainGrid" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Name="MainStackPanel" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Width="Auto" Margin="3.6,0,-90,0">
                        <Border Name="SongImageBorder" CornerRadius="4.5" ClipToBounds="True" Width="32.4" Height="32.4" Panel.ZIndex="2" MouseLeftButtonUp="SongImage_MouseLeftButtonUp" MouseEnter="SongImageBorder_MouseEnter" MouseLeave="SongImageBorder_MouseLeave">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TaskbarWidgetShowAlbumArt}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border x:Name="CompactAlbumSurface" CornerRadius="4.5" ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="CompactAlbumFlipScale" /></Border.RenderTransform>
                                <Border.Background><ImageBrush x:Name="SongImage" Stretch="UniformToFill" /></Border.Background>
                                <ui:SymbolIcon Name="SongImagePlaceholder" Symbol="MusicNote220" FontSize="21.6" Filled="True" Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorTertiary}" />
                            </Border>
                        </Border>

                        <StackPanel Name="SongInfoStackPanel" Orientation="Vertical" VerticalAlignment="Center" Width="Auto" Margin="7.2,0,0,0"
                                    ToolTipService.InitialShowDelay="800"
                                    ToolTipService.Placement="RelativePoint"
                                    ToolTipService.VerticalOffset="-16">
                            <!-- Song block: clicking anywhere on it (text or empty space) toggles
                                 the expanded state of this widget. Background=Transparent is what
                                 makes the whole block hit-testable, not just the glyphs. -->
                            <!-- No tooltip here: the outer panel already shows the song info,
                                 and an inner tooltip would mask it for long, clipped titles. -->
                            <Border x:Name="SongInfoHitArea" Background="Transparent" CornerRadius="5.4" Cursor="Hand"
                                    MouseLeftButtonUp="SongInfo_MouseLeftButtonUp"
                                    MouseEnter="SongInfo_MouseEnter"
                                    MouseLeave="SongInfo_MouseLeave">
                                <StackPanel Orientation="Vertical">
                                    <Canvas x:Name="SongTitleContainer" ClipToBounds="True" Height="18">
                                        <TextBlock x:Name="SongTitle" Text="" FontSize="11.7" FontWeight="SemiBold">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Canvas>
                                    <Canvas x:Name="SongArtistContainer" ClipToBounds="True" Margin="0,-0.9,0,0" Height="16.2">
                                        <TextBlock x:Name="SongArtist" Text="" FontSize="10.8" FontWeight="Normal" Opacity="0.65">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Canvas>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Name="ControlsStackPanel" Orientation="Horizontal" VerticalAlignment="Center" Width="Auto">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TaskbarWidgetControlsEnabled}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:Button Name="PreviousButton" Appearance="Transparent" Icon="{ui:SymbolIcon Previous20, Filled=True}" Height="28.8" Width="28.8" Padding="0" BorderThickness="0" Margin="0,0,0,-0.9" Click="Previous_Click"/>
                            <ui:Button Name="PlayPauseButton" Appearance="Transparent" Icon="{ui:SymbolIcon Pause16, Filled=True}" Height="28.8" Width="28.8" Padding="0" BorderThickness="0" Margin="0,0,0,-0.9" Click="PlayPause_Click"/>
                            <ui:Button Name="NextButton" Appearance="Transparent" Icon="{ui:SymbolIcon Next20, Filled=True}" Height="28.8" Width="28.8" Padding="0" BorderThickness="0" Margin="0,0,0,-0.9" Click="Next_Click"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>
            <controls:TaskbarWidgetExpandedContent x:Name="ExpandedContent" Width="340" Height="124" HorizontalAlignment="Left" VerticalAlignment="Top" UseLayoutRounding="False" SnapsToDevicePixels="False" Visibility="Collapsed" Opacity="0"/>
            <!-- Snapshot layer: holds a render of the previous album while a song change
                 is underway so it can crossfade into the new content underneath. -->
            <Border x:Name="CrossfadeOverlay" CornerRadius="6" ClipToBounds="True" IsHitTestVisible="False" Opacity="0" Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
