<UserControl x:Class="FluentFlyout.Controls.TaskbarWidgetExpandedContent"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid x:Name="ContentStack" Margin="14,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>
        <Grid x:Name="TopRow" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="AlbumArtBorder" Width="48" Height="48" CornerRadius="10" ClipToBounds="True"
                    Cursor="Hand"
                    ToolTip="{DynamicResource IslandTooltipChangeMedia}"
                    MouseLeftButtonUp="Album_Click"
                    MouseEnter="AlbumArt_MouseEnter" MouseLeave="AlbumArt_MouseLeave">
                <Border x:Name="AlbumFlipSurface" CornerRadius="10" ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="AlbumFlipScale"/></Border.RenderTransform>
                <Border.Background>
                    <ImageBrush x:Name="AlbumArt" Stretch="UniformToFill"/>
                </Border.Background>
                <Grid>
                    <ui:SymbolIcon x:Name="AlbumPlaceholder" Symbol="MusicNote220" Filled="True" FontSize="22"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ui:SymbolIcon x:Name="AlbumChevron" Symbol="ChevronRight20" Filled="True" FontSize="18"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                </Grid>
                </Border>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="SongInfo_Click">
                <Border x:Name="TitleMorph" ClipToBounds="True"><TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           TextTrimming="CharacterEllipsis"><TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform></TextBlock></Border>
                <Border x:Name="ArtistMorph" Visibility="Collapsed" ClipToBounds="True" Margin="0,4,0,0"><TextBlock x:Name="ArtistText" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" Opacity="0.75"
                           TextTrimming="CharacterEllipsis"><TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform></TextBlock></Border>
            </StackPanel>
        </Grid>

        <!-- Seek row: a custom track with an almost invisible native slider over it,
             exactly like the Island's, so the visual language stays the same. Only
             shown while the session reports a seekable timeline. -->
        <Grid x:Name="SeekRow" Grid.Row="1" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PosText" Grid.Column="0" Text="0:00" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11"
                       Opacity="0.6" VerticalAlignment="Center" FontFamily="Segoe UI" Typography.NumeralAlignment="Tabular"/>
            <Grid x:Name="TimelineHost" Grid.Column="1" Margin="8,0,8,0" Height="14"
                  VerticalAlignment="Center" SizeChanged="TimelineHost_SizeChanged">
                <Border x:Name="TimelineTrack" Height="5" CornerRadius="2.5" Background="#3F3F3F"
                        VerticalAlignment="Center"/>
                <Border x:Name="TimelineProgress" Width="0" Height="5" CornerRadius="2.5" Background="#969696"
                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Slider x:Name="Seekbar" AutomationProperties.Name="{DynamicResource ShowSeekbarTitle}" Minimum="0" Maximum="100" Value="0" Opacity="0.01"
                        VerticalAlignment="Stretch"
                        PreviewMouseLeftButtonDown="Seekbar_Down" PreviewMouseLeftButtonUp="Seekbar_Up"
                        PreviewMouseMove="Seekbar_Move" LostMouseCapture="Seekbar_LostCapture" ValueChanged="Seekbar_ValueChanged"/>
            </Grid>
            <TextBlock x:Name="DurText" Grid.Column="2" TextAlignment="Right" Text="0:00" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11"
                       Opacity="0.6" VerticalAlignment="Center" FontFamily="Segoe UI" Typography.NumeralAlignment="Tabular"/>
        </Grid>

        <StackPanel x:Name="ControlsRow" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:Button x:Name="PreviousButton" Appearance="Transparent" AutomationProperties.Name="{DynamicResource TaskbarWidgetPreviousTrack}" ToolTip="{DynamicResource TaskbarWidgetPreviousTrack}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Height="32" Width="32" Padding="0" BorderThickness="0" Margin="4,0" Click="Previous_Click"><ui:Button.Icon><ui:SymbolIcon x:Name="PreviousIcon" Symbol="Previous20" Filled="True" FontSize="22"/></ui:Button.Icon></ui:Button>
            <ui:Button x:Name="PlayPauseButton" Appearance="Transparent" AutomationProperties.Name="{DynamicResource IslandTooltipPlayPause}" ToolTip="{DynamicResource IslandTooltipPlayPause}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Height="32" Width="32" Padding="0" BorderThickness="0" Margin="4,0" Click="PlayPause_Click"><ui:Button.Icon><ui:SymbolIcon Symbol="Pause24" Filled="True" FontSize="22"/></ui:Button.Icon></ui:Button>
            <ui:Button x:Name="NextButton" Appearance="Transparent" AutomationProperties.Name="{DynamicResource TaskbarWidgetNextTrack}" ToolTip="{DynamicResource TaskbarWidgetNextTrack}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Height="32" Width="32" Padding="0" BorderThickness="0" Margin="4,0" Click="Next_Click"><ui:Button.Icon><ui:SymbolIcon x:Name="NextIcon" Symbol="Next20" Filled="True" FontSize="22"/></ui:Button.Icon></ui:Button>
        </StackPanel>
        </Grid>
    </Grid>
</UserControl>
